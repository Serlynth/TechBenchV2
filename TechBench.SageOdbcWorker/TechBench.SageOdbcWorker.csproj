<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TechBench.SageOdbcWorker</AssemblyName>
    <RootNamespace>TechBench.SageOdbcWorker</RootNamespace>
    <Version>2.0.0-alpha.15</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.Odbc" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Models\SageCustomer.cs" Link="Models\SageCustomer.cs" />
    <Compile Include="..\Services\SageOdbcCustomerReader.cs" Link="Services\SageOdbcCustomerReader.cs" />
  </ItemGroup>

</Project>
