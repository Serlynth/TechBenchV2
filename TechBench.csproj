<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <StartupObject>TechBench.App</StartupObject>
    <Version>1.2.4</Version>
    <AssemblyVersion>1.2.4.0</AssemblyVersion>
    <FileVersion>1.2.4.0</FileVersion>
    <Company>CSRI</Company>
    <Product>TechBench</Product>
    <Description>CSRI service worklog and posting workspace</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\csri-techbench-icon.ico</ApplicationIcon>
    <PlatformTarget Condition="'$(TechBenchTestBuild)' == 'true'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(TechBenchTestBuild)' != 'true' and '$(PlatformTarget)' == ''">x86</PlatformTarget>
    <OutputPath>bin\$(Configuration)\$(PlatformTarget)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="System.Data.Odbc" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TechBench.Tests\**\*.cs" />
    <Compile Remove="artifacts\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\common-link-*.png" />
    <None Remove="Assets\csri-techbench-logo.png" />
    <None Remove="Assets\csri-techbench-icon.ico" />
    <Resource Include="Assets\common-link-*.png" />
    <Resource Include="Assets\csri-techbench-logo.png" />
    <Resource Include="Assets\csri-techbench-icon.ico" />
  </ItemGroup>

</Project>
