<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <StartupObject>TechBench.App</StartupObject>
    <Version>0.5.6</Version>
    <AssemblyVersion>0.5.6.0</AssemblyVersion>
    <FileVersion>0.5.6.0</FileVersion>
    <AssemblyName>TechBenchV2</AssemblyName>
    <Company>CSRI</Company>
    <Product>TechBench V2</Product>
    <Description>CSRI Windows-authenticated shared SQL Server worklog workspace</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\csri-techbench-icon.ico</ApplicationIcon>
    <PlatformTarget Condition="'$(TechBenchTestBuild)' == 'true'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(TechBenchTestBuild)' != 'true' and '$(PlatformTarget)' == ''">x86</PlatformTarget>
    <OutputPath>bin\$(Configuration)\$(PlatformTarget)\</OutputPath>
    <IntermediateOutputPath Condition="'$(TechBenchTestBuild)' == 'true'">obj\$(Configuration)\TestBuild\</IntermediateOutputPath>
    <IntermediateOutputPath Condition="'$(TechBenchTestBuild)' != 'true'">obj\$(Configuration)\ClientBuild\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="System.Data.Odbc" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TechBench.Tests\**\*.cs" />
    <Compile Remove="TechBench.SyncService\**\*.cs" />
    <Compile Remove="TechBench.ServerManager\**\*.cs" />
    <Compile Remove="TechBench.ServerSetup\**\*.cs" />
    <Compile Remove="TechBench.SageOdbcWorker\**\*.cs" />
    <Compile Remove="TechBench.SyncService.Tests\**\*.cs" />
    <Compile Remove="TechBench.WHD\**\*.cs" />
    <Compile Remove="Models\WhdConnectionSettings.cs" />
    <Compile Remove="Models\WhdSyncResult.cs" />
    <Compile Remove="Providers\PostingResult.cs" />
    <Compile Remove="Providers\WhdRestClient.cs" />
    <Compile Remove="artifacts\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="TechBench.WHD\TechBench.WHD.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TechBenchTestBuild)' != 'true'">
    <Compile Remove="Data\DatabaseLocationConfig.cs" />
    <Compile Remove="Data\SqliteConnectionFactory.cs" />
    <Compile Remove="Data\TechBenchRepository.cs" />
    <Compile Remove="Providers\LocalClientProvider.cs" />
    <Compile Remove="Providers\LocalTicketProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\common-link-*.png" />
    <None Remove="Assets\common-link-*.ico" />
    <None Remove="Assets\csri-techbench-logo.png" />
    <None Remove="Assets\csri-techbench-icon.ico" />
    <Resource Include="Assets\common-link-*.png" />
    <Resource Include="Assets\common-link-*.ico" />
    <Resource Include="Assets\csri-techbench-logo.png" />
    <Resource Include="Assets\csri-techbench-icon.ico" />
  </ItemGroup>

</Project>
