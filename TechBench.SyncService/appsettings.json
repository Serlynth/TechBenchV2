    "WhdRequestTimeoutSeconds": 90,
    "SageOdbcTimeoutSeconds": 120,
    "FinalizationTimeoutSeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
