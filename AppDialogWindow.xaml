<Window x:Class="TechBench.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Icon="Assets/csri-techbench-icon.ico"
        Width="520"
        MaxHeight="700"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Border Margin="18"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="28"
                              ShadowDepth="8"
                              Opacity="0.48" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="3"
                    x:Name="AccentStrip"
                    Width="4"
                    HorizontalAlignment="Left"
                    CornerRadius="8,0,0,8" />

            <Border Grid.Row="0"
                    Background="{DynamicResource PanelAltBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Width="20"
                           Height="20"
                           Source="Assets/csri-techbench-icon.ico"
                           Stretch="Uniform"
                           VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DialogTitle}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="10,0,12,0"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <Button Grid.Column="2"
                            Content="&#x00D7;"
                            FontFamily="Segoe UI"
                            FontSize="18"
                            Width="34"
                            Height="32"
                            MinHeight="32"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            ToolTip="Close"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26,24,26,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBadge"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{DynamicResource PanelAltBackgroundBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock x:Name="IconGlyph"
                               FontFamily="Segoe UI Symbol"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap" />
                </Border>

                <TextBox Grid.Column="1"
                         Style="{x:Null}"
                         Text="{Binding DialogMessage, Mode=OneWay}"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         IsTabStop="False"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Background="Transparent"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         BorderThickness="0"
                         Padding="0"
                         FontFamily="Segoe UI"
                         FontSize="13"
                         TextBlock.LineHeight="20"
                         MaxHeight="330"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled" />
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelAltBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="18,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton"
                            MinWidth="96"
                            Margin="0,0,8,0"
                            Click="SecondaryButton_Click" />
                    <Button x:Name="PrimaryButton"
                            MinWidth="96"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="PrimaryButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
