<Window x:Class="TechBench.DatabaseConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect TechBench V2"
        Width="520"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="TechBench V2"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Text="Connect directly to the shared SQL Server using your current Windows domain identity. No TechBench password is stored." />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Margin="0,0,0,6"
                       FontWeight="SemiBold"
                       Text="SQL Server or instance" />
            <TextBox x:Name="ServerTextBox"
                     Height="38"
                     Padding="10,7"
                     VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Margin="0,0,0,6"
                       FontWeight="SemiBold"
                       Text="Database" />
            <TextBox x:Name="DatabaseTextBox"
                     Height="38"
                     Padding="10,7"
                     VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock FontWeight="SemiBold"
                       Text="Windows identity" />
            <TextBlock x:Name="WindowsIdentityTextBlock"
                       Margin="0,5,0,8"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <CheckBox x:Name="TrustServerCertificateCheckBox"
                      Content="Trust the SQL Server certificate (temporary/test use)" />
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="4"
                   MinHeight="42"
                   Margin="0,2,0,14"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    Content="Cancel" />
            <Button x:Name="ConnectButton"
                    Width="120"
                    Height="38"
                    IsDefault="True"
                    Click="ConnectButton_Click"
                    Content="Connect" />
        </StackPanel>
    </Grid>
</Window>
