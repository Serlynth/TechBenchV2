<Window x:Class="TechBench.DatabaseConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect TechBench V2"
        Width="620"
        Height="680"
        MinWidth="520"
        MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontSize="15"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ConnectionTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ConnectionLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <Grid Margin="36,28,36,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="TechBench V2"
                               FontSize="32"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0"
                               FontSize="15"
                               LineHeight="22"
                               Foreground="#D6E2EF"
                               TextWrapping="Wrap"
                               Text="Sign in securely with your current Windows domain identity. TechBench does not store a separate password." />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource ConnectionLabelStyle}"
                               Text="SQL Server or instance" />
                    <TextBox x:Name="ServerTextBox"
                             Style="{StaticResource ConnectionTextBoxStyle}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource ConnectionLabelStyle}"
                               Text="Database" />
                    <TextBox x:Name="DatabaseTextBox"
                             Style="{StaticResource ConnectionTextBoxStyle}" />
                </StackPanel>

                <Border Grid.Row="3"
                        Margin="0,0,0,16"
                        Padding="16"
                        CornerRadius="10"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ConnectionLabelStyle}"
                                   Text="Signing in as" />
                        <TextBlock x:Name="WindowsIdentityTextBlock"
                                   Margin="0,0,0,10"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF" />
                        <CheckBox x:Name="TrustServerCertificateCheckBox">
                            <TextBlock FontSize="14"
                                       Foreground="#D6E2EF"
                                       TextWrapping="Wrap"
                                       Text="Trust the SQL Server certificate (temporary/test use)" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Padding="16"
                        CornerRadius="10"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <CheckBox x:Name="PreviewAnotherUserCheckBox">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="Admin: preview another registered user (read-only)" />
                        </CheckBox>

                        <StackPanel Margin="24,8,0,0"
                                    Visibility="{Binding IsChecked, ElementName=PreviewAnotherUserCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="0,0,0,12"
                                       FontSize="14"
                                       LineHeight="20"
                                       Foreground="#D6E2EF"
                                       TextWrapping="Wrap"
                                       Text="This does not sign in as that person. Your Windows identity remains authenticated, and SQL Server restricts the preview to read-only access. The user must have opened TechBench V2 within the past hour." />
                            <TextBlock Style="{StaticResource ConnectionLabelStyle}"
                                       Text="Domain username or short username" />
                            <TextBox x:Name="PreviewUsernameTextBox"
                                     Style="{StaticResource ConnectionTextBoxStyle}"
                                     MaxLength="256"
                                     ToolTip="For example: username or CSRI\username" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1"
                Padding="36,16"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           LineHeight="20"
                           Foreground="#D6E2EF"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="1"
                            Margin="0,12,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="UpdateButton"
                            MinWidth="150"
                            MinHeight="44"
                            Margin="0,0,10,0"
                            Padding="14,10"
                            FontSize="14"
                            Click="UpdateButton_Click"
                            Content="Check for updates" />
                    <Button MinWidth="96"
                            MinHeight="44"
                            Margin="0,0,10,0"
                            FontSize="14"
                            IsCancel="True"
                            Click="CancelButton_Click"
                            Content="Cancel" />
                    <Button x:Name="ConnectButton"
                            MinWidth="176"
                            MinHeight="44"
                            Padding="18,10"
                            FontSize="14"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Click="ConnectButton_Click"
                            Content="Connect with Windows" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
