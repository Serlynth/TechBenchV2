                                            Margin="0,0,6,6" />
                                    <Button Content="Save copy"
                                            Command="{Binding DownloadAttachmentCommand}"
                                            Padding="10,5"
                                            Margin="0,0,6,6" />
                                    <Button Content="Edit"
                                            Command="{Binding EditAttachmentCommand}"
                                            Padding="10,5"
                                            Margin="0,0,6,6" />
                                    <Button Content="Link equipment"
                                            Command="{Binding LinkAttachmentToEquipmentCommand}"
                                            Padding="10,5"
                                            Margin="0,0,6,6" />
                                    <Button Content="Archive"
                                            Command="{Binding ArchiveAttachmentCommand}"
                                            Padding="10,5"
                                            Margin="0,0,6,6"
                                            Visibility="{Binding SelectedAttachment.IsArchived, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <Button Content="Restore"
                                            Command="{Binding RestoreAttachmentCommand}"
                                            Padding="10,5"
                                            Margin="0,0,6,6"
                                            Visibility="{Binding SelectedAttachment.IsArchived, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10"
                            Margin="0,10,0,0">
                        <TextBlock Text="Drop files anywhere on this Attachments page, or copy a screenshot and choose Paste. Existing files are never deleted when archived."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Other Information">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Other Information"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <Button Grid.Column="1"
                                Content="Add"
                                Command="{Binding AddFactCommand}"
                                MinWidth="76"
                                Margin="0,0,8,8" />
                        <Button Grid.Column="2"
                                Content="Edit"
                                Command="{Binding EditFactCommand}"
                                MinWidth="76"
                                Margin="0,0,0,8" />
                    </Grid>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Facts}"
                              SelectedItem="{Binding SelectedFact}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              ClipboardCopyMode="IncludeHeader"
                              MouseDoubleClick="Facts_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Section"
                                                Binding="{Binding SectionName}"
                                                Width="0.9*" />
                            <DataGridTextColumn Header="Field"
                                                Binding="{Binding FieldLabel}"
                                                Width="1.2*" />
                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding ValueText}"
                                                Width="2.4*" />
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding ValueType}"
                                                Width="0.7*" />
                            <DataGridTextColumn Header="Review"
                                                Binding="{Binding ReviewStatus}"
                                                MinWidth="100" />
                            <DataGridCheckBoxColumn Header="Active"
                                                    Binding="{Binding IsActive}"
                                                    MinWidth="65" />
                            <DataGridTextColumn Header="Last Verified"
                                                Binding="{Binding LastVerifiedAtUtc, StringFormat={}{0:g}}"
                                                MinWidth="125" />
                            <DataGridTextColumn Header="Updated"
                                                Binding="{Binding UpdatedAtUtc, StringFormat={}{0:g}}"
                                                MinWidth="125" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Needs Sorting"
                     Content="{Binding NeedsSortingGroup}"
                     ContentTemplate="{StaticResource ResourceCategoryContentTemplate}" />

            <TabItem Header="Migration" Visibility="Collapsed">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.15*" />
                        <RowDefinition Height="0.85*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Per-client migration"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="Stage → validate → review → approve → promote. Staging never changes canonical records."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,3,0,12" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Create workbook"
                                Command="{Binding CreateTemplateCommand}"
                                MinWidth="125"
                                Margin="0,0,8,12" />
                        <Button Grid.Column="2"
                                Content="Stage workbook"
                                Command="{Binding ImportWorkbookCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="125"
                                Margin="0,0,0,12" />
                    </Grid>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ImportBatches}"
                              SelectedItem="{Binding SelectedImportBatch}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Created"
                                                Binding="{Binding CreatedAtUtc, StringFormat={}{0:g}}"
                                                Width="1*" />
                            <DataGridTextColumn Header="State"
                                                Binding="{Binding State}"
                                                Width="0.8*" />
                            <DataGridTextColumn Header="Records"
                                                Binding="{Binding RecordCount}"
                                                Width="0.55*" />
                            <DataGridTextColumn Header="Secrets"
                                                Binding="{Binding SecretCount}"
                                                Width="0.55*" />
                            <DataGridTextColumn Header="FD matches"
                                                Binding="{Binding SecretMatchCount}"
                                                Width="0.65*" />
                            <DataGridTextColumn Header="FD mismatches"
                                                Binding="{Binding SecretMismatchCount}"
                                                Width="0.75*" />
                            <DataGridTextColumn Header="Errors"
                                                Binding="{Binding BlockingIssueCount}"
                                                Width="0.55*" />
                            <DataGridTextColumn Header="Warnings"
                                                Binding="{Binding WarningCount}"
                                                Width="0.6*" />
                            <DataGridTextColumn Header="Message"
                                                Binding="{Binding Message}"
                                                Width="2.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding ImportIssues}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity"
                                                    Binding="{Binding Severity}"
                                                    Width="0.7*" />
                                <DataGridTextColumn Header="Code"
                                                    Binding="{Binding IssueCode}"
                                                    Width="1*" />
                                <DataGridTextColumn Header="Issue"
                                                    Binding="{Binding Message}"
                                                    Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Column="1"
                                    Margin="14,0,0,0"
                                    Width="145">
                            <Button Content="Refresh review"
                                    Command="{Binding ReloadImportCommand}"
                                    Margin="0,0,0,8" />
                            <Button Content="Compare FireDrill"
                                    Command="{Binding CompareImportCommand}"
                                    Margin="0,0,0,8" />
                            <Button Content="Approve"
                                    Command="{Binding ApproveImportCommand}"
                                    Margin="0,0,0,8" />
                            <Button Content="Promote to SQL"
                                    Command="{Binding PromoteImportCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{DynamicResource SuccessBrush}"
                             Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
