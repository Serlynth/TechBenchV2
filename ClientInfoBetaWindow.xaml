<Window x:Class="TechBench.ClientInfoBetaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TechBench.Converters"
        Title="{Binding WindowTitle}"
        Icon="Assets/csri-techbench-icon.ico"
        Width="1260"
        Height="820"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:InverseBooleanToVisibilityConverter
            x:Key="InverseBooleanToVisibilityConverter" />
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="SubtleLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="DataGridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="3,0" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{DynamicResource PanelAltBackgroundBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10,0,0,10"
                                    Padding="8">
                                <TabPanel
                                      IsItemsHost="True"
                                      Background="Transparent"
                                      Margin="0" />
                            </Border>
                            <Border Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0,10,10,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource PanelBackgroundBrush}" />
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource MutedTextBrush}" />
                                <Setter Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResourceCategoryContentTemplate">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CategoryName}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,10" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Add"
                            Command="{Binding DataContext.AddResourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding CategoryName}"
                            MinWidth="76"
                            Margin="0,0,8,8" />
                    <Button Grid.Column="2"
                            Content="Edit"
                            Command="{Binding DataContext.EditResourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            MinWidth="76"
                            Margin="0,0,0,8" />
                </Grid>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Resources}"
                          SelectedItem="{Binding DataContext.SelectedResource, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          MouseDoubleClick="Resources_DoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Name}"
                                            Width="1.2*" />
                        <DataGridTextColumn Header="Type"
                                            Binding="{Binding TypeLabel}"
                                            Width="0.9*" />
                        <DataGridTextColumn Header="Provider"
                                            Binding="{Binding Provider}"
                                            Width="0.9*" />
                        <DataGridTextColumn Header="Address / URL"
                                            Binding="{Binding AddressOrUrl}"
                                            Width="1.5*" />
                        <DataGridTextColumn Header="Location"
                                            Binding="{Binding LocationName}"
                                            Width="0.9*" />
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="0.7*" />
                        <DataGridTextColumn Header="Review"
                                            Binding="{Binding ReviewStatus}"
                                            Width="0.8*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DataTemplate>

        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="AlternationCount" Value="2" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D2340" Offset="0" />
                    <GradientStop Color="#173B60" Offset="0.6" />
                    <GradientStop Color="#0B1728" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="30,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CANONICAL CLIENT INFO · BETA"
                               Foreground="#8DBEFF"
                               FontSize="11"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding ClientName}"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,5,0,8"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#243B5A"
                                BorderBrush="#41658F"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="11,5"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding InternalClientIdLabel}"
                                       Foreground="#EAF3FF" />
                        </Border>
                        <Border Background="#112D25"
                                BorderBrush="{DynamicResource SuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="11,5">
                            <TextBlock Text="{Binding ClientInfoStatusLabel}"
                                       Foreground="#BDF7DC" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            MinWidth="96"
                            Margin="0,0,8,0" />
                    <Button Content="Close"
                            MinWidth="96"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="22,18,22,12"
                    TabStripPlacement="Left"
                    Background="{DynamicResource PanelBackgroundBrush}">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <TextBlock Text="Overview"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="Contact details are synchronized from the existing client record. The summary and review state belong to canonical Client Info."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,18" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="MAIN CONTACT"
                                               Style="{StaticResource SubtleLabelStyle}" />
                                    <TextBlock Text="{Binding Profile.WhdContactName}"
                                               FontSize="16"
                                               Margin="0,4,0,12" />
                                    <TextBlock Text="EMAIL"
                                               Style="{StaticResource SubtleLabelStyle}" />
                                    <TextBlock Text="{Binding Profile.WhdContactEmail}"
                                               Margin="0,4,0,12" />
                                    <TextBlock Text="PHONE"
                                               Style="{StaticResource SubtleLabelStyle}" />
                                    <TextBlock Text="{Binding Profile.WhdPhone}"
                                               Margin="0,4,0,12" />
                                    <TextBlock Text="ADDRESS"
                                               Style="{StaticResource SubtleLabelStyle}" />
                                    <TextBlock Text="{Binding Profile.WhdAddress}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource PanelAltBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18"
                                    Margin="8,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="CANONICAL SUMMARY"
                                               Style="{StaticResource SubtleLabelStyle}" />
                                    <TextBox Grid.Row="1"
                                             Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="155"
                                             Margin="0,6,0,12"
                                             Padding="10" />
                                    <ComboBox Grid.Row="2"
                                              ItemsSource="{Binding ReviewStatusOptions}"
                                              SelectedItem="{Binding ReviewStatus}"
                                              MinWidth="190"
                                              HorizontalAlignment="Left"
                                              Margin="0,0,0,12"
                                              IsEnabled="{Binding CanEdit}" />
                                    <Button Grid.Row="3"
                                            Content="Save overview"
                                            Command="{Binding SaveProfileCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Right"
                                            MinWidth="130" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="People &amp; Locations">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="1.25*" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,9,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Locations"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <Button Grid.Column="1"
                                    Content="Add"
                                    Command="{Binding AddLocationCommand}"
                                    Margin="0,0,8,8"
                                    MinWidth="70" />
                            <Button Grid.Column="2"
                                    Content="Edit"
                                    Command="{Binding EditLocationCommand}"
                                    Margin="0,0,0,8"
                                    MinWidth="70" />
                        </Grid>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Locations}"
                                  SelectedItem="{Binding SelectedLocation}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  MouseDoubleClick="Locations_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Name}"
                                                    Width="1.1*" />
                                <DataGridTextColumn Header="Type"
                                                    Binding="{Binding LocationType}"
                                                    Width="0.7*" />
                                <DataGridTextColumn Header="Address"
                                                    Binding="{Binding AddressLabel}"
                                                    Width="1.5*" />
                                <DataGridTextColumn Header="Review"
                                                    Binding="{Binding ReviewStatus}"
                                                    Width="0.8*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Grid Grid.Column="1" Margin="9,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="People"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <Button Grid.Column="1"
                                    Content="Add"
                                    Command="{Binding AddPersonCommand}"
                                    Margin="0,0,8,8"
                                    MinWidth="70" />
                            <Button Grid.Column="2"
                                    Content="Edit"
                                    Command="{Binding EditPersonCommand}"
                                    Margin="0,0,0,8"
                                    MinWidth="70" />
                        </Grid>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding People}"
                                  SelectedItem="{Binding SelectedPerson}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  MouseDoubleClick="People_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding DisplayName}"
                                                    Width="1.1*" />
                                <DataGridTextColumn Header="Role"
                                                    Binding="{Binding RoleDepartment}"
                                                    Width="1*" />
                                <DataGridTextColumn Header="Email"
                                                    Binding="{Binding Email}"
                                                    Width="1.2*" />
                                <DataGridTextColumn Header="Location"
                                                    Binding="{Binding LocationName}"
                                                    Width="0.8*" />
                                <DataGridTextColumn Header="Review"
                                                    Binding="{Binding ReviewStatus}"
                                                    Width="0.8*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Equipment">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Equipment"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="Computers, servers, printers, network appliances, and other devices assigned to this client. Equipment remains shared with the TechBench Inventory workspace."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,10" />
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Equipment}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding Name}"
                                                Width="1.1*" />
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding DeviceType}"
                                                Width="0.8*" />
                            <DataGridTextColumn Header="Manufacturer / Model"
                                                Binding="{Binding ModelLine}"
                                                Width="1.2*" />
                            <DataGridTextColumn Header="Serial Number"
                                                Binding="{Binding SerialNumber}"
                                                Width="1*" />
                            <DataGridTextColumn Header="Asset Tag"
                                                Binding="{Binding AssetTag}"
                                                Width="0.8*" />
                            <DataGridTextColumn Header="IP Address"
                                                Binding="{Binding IpAddress}"
                                                Width="0.9*" />
                            <DataGridTextColumn Header="Location"
                                                Binding="{Binding LocationName}"
                                                Width="0.9*" />
                            <DataGridTextColumn Header="Assigned To"
                                                Binding="{Binding ClientUserDisplayName}"
                                                Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Servers &amp; Infrastructure"
                     Content="{Binding ServerInfrastructureGroup}"
                     ContentTemplate="{StaticResource ResourceCategoryContentTemplate}" />

            <TabItem Header="Network &amp; Internet"
                     Content="{Binding NetworkInternetGroup}"
                     ContentTemplate="{StaticResource ResourceCategoryContentTemplate}" />

            <TabItem Header="Applications &amp; Cloud"
                     Content="{Binding ApplicationsCloudGroup}"
                     ContentTemplate="{StaticResource ResourceCategoryContentTemplate}" />

            <TabItem Header="Domains &amp; Email"
                     Content="{Binding DomainsEmailGroup}"
                     ContentTemplate="{StaticResource ResourceCategoryContentTemplate}" />

            <TabItem Header="Backup &amp; Security"
                     Content="{Binding BackupSecurityGroup}"
                     ContentTemplate="{StaticResource ResourceCategoryContentTemplate}" />

            <TabItem Header="Vendors &amp; Services"
                     Content="{Binding VendorsServicesGroup}"
                     ContentTemplate="{StaticResource ResourceCategoryContentTemplate}" />

            <TabItem Header="Needs Sorting"
                     Content="{Binding NeedsSortingGroup}"
                     ContentTemplate="{StaticResource ResourceCategoryContentTemplate}" />

            <TabItem Header="Passwords">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Passwords"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <Button Grid.Column="1"
                                    Content="Add"
                                    Command="{Binding AddCredentialCommand}"
                                    MinWidth="76"
                                    Margin="0,0,8,8" />
                            <Button Grid.Column="2"
                                    Content="Edit"
                                    Command="{Binding EditCredentialCommand}"
                                    MinWidth="76"
                                    Margin="0,0,0,8" />
                        </Grid>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Credentials}"
                                  SelectedItem="{Binding SelectedCredential}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  MouseDoubleClick="Credentials_DoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Name}"
                                                    Width="1.1*" />
                                <DataGridTextColumn Header="Category"
                                                    Binding="{Binding Category}"
                                                    Width="0.8*" />
                                <DataGridTextColumn Header="Username"
                                                    Binding="{Binding Username}"
                                                    Width="1.2*" />
                                <DataGridTextColumn Header="Login URL"
                                                    Binding="{Binding LoginUrl}"
                                                    Width="1.3*" />
                                <DataGridTextColumn Header="Secrets"
                                                    Binding="{Binding SecretCount}"
                                                    Width="0.5*" />
                                <DataGridTextColumn Header="Review"
                                                    Binding="{Binding ReviewStatus}"
                                                    Width="0.8*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Border Grid.Column="1"
                            Background="{DynamicResource PanelAltBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16"
                            Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding SelectedCredential.Name, TargetNullValue=Select a credential}"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Row="1"
                                    Content="Add password / secret"
                                    Command="{Binding AddSecretCommand}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,12" />
                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedCredential.Secrets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SecretLabel}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding SecretType}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="11"
                                                               Margin="0,2,0,7" />
                                                    <WrapPanel>
                                                        <Button Content="Reveal"
                                                                Command="{Binding DataContext.RevealSecretCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="0,0,6,0"
                                                                Padding="9,4" />
                                                        <Button Content="Copy"
                                                                Command="{Binding DataContext.CopySecretCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="0,0,6,0"
                                                                Padding="9,4" />
                                                        <Button Content="Replace"
                                                                Command="{Binding DataContext.ReplaceSecretCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="9,4" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Other Information">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Other Information"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <Button Grid.Column="1"
                                Content="Add"
                                Command="{Binding AddFactCommand}"
                                MinWidth="76"
                                Margin="0,0,8,8" />
                        <Button Grid.Column="2"
                                Content="Edit"
                                Command="{Binding EditFactCommand}"
                                MinWidth="76"
                                Margin="0,0,0,8" />
                    </Grid>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Facts}"
                              SelectedItem="{Binding SelectedFact}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              MouseDoubleClick="Facts_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Section"
                                                Binding="{Binding SectionName}"
                                                Width="0.9*" />
                            <DataGridTextColumn Header="Field"
                                                Binding="{Binding FieldLabel}"
                                                Width="1.2*" />
                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding ValueText}"
                                                Width="2.4*" />
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding ValueType}"
                                                Width="0.7*" />
                            <DataGridTextColumn Header="Review"
                                                Binding="{Binding ReviewStatus}"
                                                Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Migration" Visibility="Collapsed">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.15*" />
                        <RowDefinition Height="0.85*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Per-client migration"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="Stage → validate → review → approve → promote. Staging never changes canonical records."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,3,0,12" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Create workbook"
                                Command="{Binding CreateTemplateCommand}"
                                MinWidth="125"
                                Margin="0,0,8,12" />
                        <Button Grid.Column="2"
                                Content="Stage workbook"
                                Command="{Binding ImportWorkbookCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="125"
                                Margin="0,0,0,12" />
                    </Grid>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ImportBatches}"
                              SelectedItem="{Binding SelectedImportBatch}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Created"
                                                Binding="{Binding CreatedAtUtc, StringFormat={}{0:g}}"
                                                Width="1*" />
                            <DataGridTextColumn Header="State"
                                                Binding="{Binding State}"
                                                Width="0.8*" />
                            <DataGridTextColumn Header="Records"
                                                Binding="{Binding RecordCount}"
                                                Width="0.55*" />
                            <DataGridTextColumn Header="Secrets"
                                                Binding="{Binding SecretCount}"
                                                Width="0.55*" />
                            <DataGridTextColumn Header="FD matches"
                                                Binding="{Binding SecretMatchCount}"
                                                Width="0.65*" />
                            <DataGridTextColumn Header="FD mismatches"
                                                Binding="{Binding SecretMismatchCount}"
                                                Width="0.75*" />
                            <DataGridTextColumn Header="Errors"
                                                Binding="{Binding BlockingIssueCount}"
                                                Width="0.55*" />
                            <DataGridTextColumn Header="Warnings"
                                                Binding="{Binding WarningCount}"
                                                Width="0.6*" />
                            <DataGridTextColumn Header="Message"
                                                Binding="{Binding Message}"
                                                Width="2.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DataGrid ItemsSource="{Binding ImportIssues}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity"
                                                    Binding="{Binding Severity}"
                                                    Width="0.7*" />
                                <DataGridTextColumn Header="Code"
                                                    Binding="{Binding IssueCode}"
                                                    Width="1*" />
                                <DataGridTextColumn Header="Issue"
                                                    Binding="{Binding Message}"
                                                    Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Column="1"
                                    Margin="14,0,0,0"
                                    Width="145">
                            <Button Content="Refresh review"
                                    Command="{Binding ReloadImportCommand}"
                                    Margin="0,0,0,8" />
                            <Button Content="Compare FireDrill"
                                    Command="{Binding CompareImportCommand}"
                                    Margin="0,0,0,8" />
                            <Button Content="Approve"
                                    Command="{Binding ApproveImportCommand}"
                                    Margin="0,0,0,8" />
                            <Button Content="Promote to SQL"
                                    Command="{Binding PromoteImportCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{DynamicResource SuccessBrush}"
                             Margin="0,0,10,0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
