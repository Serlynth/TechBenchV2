<Window x:Class="TechBench.ClientInfoBetaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TechBench.Converters"
        xmlns:controls="clr-namespace:TechBench.Controls"
        Title="{Binding WindowTitle}"
        Icon="Assets/csri-techbench-icon.ico"
        Width="1260"
        Height="820"
        MinWidth="980"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:InverseBooleanToVisibilityConverter
            x:Key="InverseBooleanToVisibilityConverter" />
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="SubtleLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="DataGridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="3,0" />
        </Style>
        <Style x:Key="SelectableValueStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="ToolTip" Value="Select text and press Ctrl+C to copy" />
        </Style>
        <DataTemplate x:Key="OverviewFieldTemplate">
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1">
                    <TextBox Text="{Binding Value, Mode=OneWay}"
                             Style="{StaticResource SelectableValueStyle}" />
                    <ItemsControl ItemsSource="{Binding Secrets}"
                                  Visibility="{Binding HasSecrets, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <WrapPanel Margin="0,5,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SecretLabel}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,7,0" />
                                    <TextBox Text="{Binding InlineDisplayValue, Mode=OneWay}"
                                             Style="{StaticResource SelectableValueStyle}"
                                             VerticalContentAlignment="Center"
                                             MinWidth="120"
                                             MaxWidth="260"
                                             Margin="0,0,7,0" />
                                    <Button Content="{Binding InlineRevealLabel}"
                                            Command="{Binding DataContext.RevealSecretCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,3"
                                            Margin="0,0,5,0" />
                                    <Button Content="Copy"
                                            Command="{Binding DataContext.CopySecretCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,3" />
                                </WrapPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{DynamicResource PanelAltBackgroundBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10,0,0,10"
                                    Padding="8">
                                <TabPanel
                                      IsItemsHost="True"
                                      Background="Transparent"
                                      Margin="0" />
                            </Border>
                            <Border Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0,10,10,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{DynamicResource PanelBackgroundBrush}" />
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource MutedTextBrush}" />
                                <Setter Property="Opacity" Value="0.68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResourceCategoryContentTemplate">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CategoryName}"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,10" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Add"
                            Command="{Binding DataContext.AddResourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding CategoryName}"
                            MinWidth="76"
                            Margin="0,0,8,8" />
                    <Button Grid.Column="2"
                            Content="Edit"
                            Command="{Binding DataContext.EditResourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding SelectedResource}"
                            MinWidth="76"
                            Margin="0,0,8,8" />
                    <Button Grid.Column="3"
                            Content="Move"
                            Command="{Binding DataContext.MoveResourceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding SelectedResource}"
                            MinWidth="76"
                            Margin="0,0,8,8" />
                    <Button Grid.Column="4"
                            Content="Custom Fields"
                            Command="{Binding DataContext.ManageResourceFieldsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding SelectedResource}"
                            MinWidth="108"
                            Margin="0,0,0,8" />
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0.48*" MinHeight="170" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0.52*" MinHeight="170" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Selected record"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedOverviewLabel}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="10,1,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="9,3"
                                Margin="8,0,0,7">
                            <TextBlock Text="{Binding OverviewCountLabel}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="10" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBlock Text="Select a record in the full list to see its important information."
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasOverviewSections, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <ListBox ItemsSource="{Binding OverviewSections}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Focusable="False"
                             Visibility="{Binding HasOverviewSections, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,12,12" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardBorder"
                                                    Background="{DynamicResource PanelAltBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="500" MinHeight="170" Margin="15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,0,10" />
                                    </Grid>
                                    <ItemsControl Grid.Row="1"
                                                  ItemsSource="{Binding Fields}"
                                                  ItemTemplate="{StaticResource OverviewFieldTemplate}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <GridSplitter Grid.Row="2"
                                  Height="4"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource BorderBrush}"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext" />
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                Margin="0,8,0,7">
                        <TextBlock Text="Full list"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="All fields · select or double-click to edit"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="10,1,0,0" />
                    </StackPanel>
                    <controls:ClientInfoResourceDataGrid Grid.Row="4"
                                                         ItemsSource="{Binding Resources}"
                                                         SelectedItem="{Binding SelectedResource, Mode=TwoWay}"
                                                         ClipboardCopyMode="IncludeHeader"
                                                         MouseDoubleClick="Resources_DoubleClick" />
                </Grid>
            </Grid>
        </DataTemplate>

        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="RowHeight" Value="38" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- Implicit DataGrid styles do not flow to a derived custom control. -->
        <Style TargetType="{x:Type controls:ClientInfoResourceDataGrid}"
               BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource PanelAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style x:Key="ColumnHeaderGripperStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="10" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent">
                            <Border x:Name="ResizeIndicator"
                                    Width="1"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource BorderBrush}"
                                    Opacity="0"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ResizeIndicator"
                                        Property="Opacity"
                                        Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ResizeIndicator"
                                        Property="Width"
                                        Value="2" />
                                <Setter TargetName="ResizeIndicator"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ResizeIndicator"
                                        Property="Opacity"
                                        Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   Style="{StaticResource ColumnHeaderGripperStyle}"
                                   HorizontalAlignment="Left" />
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   Style="{StaticResource ColumnHeaderGripperStyle}"
                                   HorizontalAlignment="Right" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150" />
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D2340" Offset="0" />
                    <GradientStop Color="#173B60" Offset="0.6" />
                    <GradientStop Color="#0B1728" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="30,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CANONICAL CLIENT INFO · BETA"
                               Foreground="#8DBEFF"
                               FontSize="11"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding ClientName}"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,5,0,8"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#243B5A"
                                BorderBrush="#41658F"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="11,5"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding InternalClientIdLabel}"
                                       Foreground="#EAF3FF" />
                        </Border>
                        <Border Background="#112D25"
                                BorderBrush="{DynamicResource SuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="11,5">
                            <TextBlock Text="{Binding ClientInfoStatusLabel}"
                                       Foreground="#BDF7DC" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            MinWidth="96"
                            Margin="0,0,8,0" />
                    <Button Content="Close"
                            MinWidth="96"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="22,18,22,12"
                    TabStripPlacement="Left"
                    Background="{DynamicResource PanelBackgroundBrush}">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22">
                        <TextBlock Text="Overview"
                                   Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="Contact details are synchronized from the existing client record. The summary and review state belong to canonical Client Info."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,18" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18"
                                    Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="MAIN CONTACT"
                                               Style="{StaticResource SubtleLabelStyle}" />
                                    <TextBox Text="{Binding Profile.WhdContactName, Mode=OneWay}"
                                             Style="{StaticResource SelectableValueStyle}"
                                             FontSize="16"
                                             Margin="0,4,0,12" />
                                    <TextBlock Text="EMAIL"
                                               Style="{StaticResource SubtleLabelStyle}" />
                                    <TextBox Text="{Binding Profile.WhdContactEmail, Mode=OneWay}"
                                             Style="{StaticResource SelectableValueStyle}"
                                             Margin="0,4,0,12" />
                                    <TextBlock Text="PHONE"
                                               Style="{StaticResource SubtleLabelStyle}" />
                                    <TextBox Text="{Binding Profile.WhdPhone, Mode=OneWay}"
                                             Style="{StaticResource SelectableValueStyle}"
                                             Margin="0,4,0,12" />
                                    <TextBlock Text="ADDRESS"
                                               Style="{StaticResource SubtleLabelStyle}" />
                                    <TextBox Text="{Binding Profile.WhdAddress, Mode=OneWay}"
                                             Style="{StaticResource SelectableValueStyle}"
                                             Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource PanelAltBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18"
                                    Margin="8,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="CANONICAL SUMMARY"
                                               Style="{StaticResource SubtleLabelStyle}" />
                                    <TextBox Grid.Row="1"
                                             Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="155"
                                             Margin="0,6,0,12"
                                             Padding="10" />
                                    <ComboBox Grid.Row="2"
                                              ItemsSource="{Binding ReviewStatusOptions}"
                                              SelectedItem="{Binding ReviewStatus}"
                                              MinWidth="190"
                                              HorizontalAlignment="Left"
                                              Margin="0,0,0,12"
                                              IsEnabled="{Binding CanEdit}" />
                                    <Button Grid.Row="3"
                                            Content="Save overview"
                                            Command="{Binding SaveProfileCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Right"
                                            MinWidth="130" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Margin="0,24,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Technician quick reference"
                                           Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock Text="The most-used operational details across every category. Select any value to copy it; use the category tabs for every record, every field, and editing."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,12,10" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="9,3"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding QuickReferenceCountLabel}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10" />
                            </Border>
