<Window x:Class="TechBench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:TechBench.Converters"
        xmlns:controls="clr-namespace:TechBench.Controls"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="Assets/csri-techbench-icon.ico"
        Height="900"
        Width="1420"
        MinHeight="720"
        MinWidth="1120"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveEntryCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshAllCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <conv:SectionVisibilityConverter x:Key="SectionVisibilityConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="1,0,0,7" />
        </Style>

        <Style x:Key="SectionHeadingStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="HeaderUpdateButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="UpdateBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UpdateBorder" Property="Background" Value="{DynamicResource SuccessSoftHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="UpdateBorder" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="UpdateBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TableHeaderTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="TableCellTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <DataTemplate x:Key="ClientOptionTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       Foreground="{DynamicResource ComboBoxTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="EditorClientOptionTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       Foreground="{DynamicResource ComboBoxTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <Style x:Key="EditorClientComboBoxItemStyle"
               TargetType="{x:Type ComboBoxItem}"
               BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="EditorClientComboBoxItem_PreviewMouseLeftButtonUp" />
        </Style>

        <DataTemplate x:Key="TicketSelectorItemTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="TicketStatusOptionTemplate">
            <TextBlock Text="{Binding DisplayName}"
                       Foreground="{DynamicResource ComboBoxTextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <Style x:Key="TicketSelectorListStyle" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="74" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="TicketSelectorItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource ComboBoxTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ComboBoxBackgroundBrush}" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboBoxHighlightBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ComboBoxHighlightTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboBoxHighlightBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ComboBoxHighlightTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="118" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="EditorPrimaryActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="EditorDangerActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="EditorContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorContextMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EntryCardButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectableEntryCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14,11" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarGroupLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SidebarMutedTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="16,17,0,6" />
        </Style>

        <Style x:Key="SidebarChildButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Padding" Value="16,10" />
        </Style>

        <Style x:Key="NavTodayStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarChildButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Today"><Setter Property="Tag" Value="Active" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NavWeekStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarChildButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="This Week"><Setter Property="Tag" Value="Active" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NavHistoryStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarChildButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="History"><Setter Property="Tag" Value="Active" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NavSearchStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarChildButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Search"><Setter Property="Tag" Value="Active" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NavQueueStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarChildButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Posting Queue"><Setter Property="Tag" Value="Active" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NavClientsStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarChildButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Client List"><Setter Property="Tag" Value="Active" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NavTicketsStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarChildButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Ticket List"><Setter Property="Tag" Value="Active" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NavLinksStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarChildButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Common Links"><Setter Property="Tag" Value="Active" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NavCredentialsStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarChildButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Client Credentials"><Setter Property="Tag" Value="Active" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NavPostingHistoryStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarChildButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Posting History"><Setter Property="Tag" Value="Active" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NavAdminCenterStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarChildButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Admin Center"><Setter Property="Tag" Value="Active" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NavSettingsStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SidebarButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding CurrentSection}" Value="Settings"><Setter Property="Tag" Value="Active" /></DataTrigger></Style.Triggers></Style>

        <Style x:Key="BadgeTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#101820" />
        </Style>

        <DataTemplate x:Key="EntryCardTemplate">
            <Border Style="{StaticResource SelectableEntryCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="122" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="{Binding TimeRange}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Visibility="{Binding HasTimeRange, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding DurationLabel}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ClientDisplay}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding PostingStatusLabel}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       TextAlignment="Right"
                                       VerticalAlignment="Top"
                                       MaxWidth="125"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="{Binding TicketDisplay}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,3,0,8" />
                        <TextBlock Text="{Binding DisplayPreview}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,10" />
                        <WrapPanel>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource BadgeStyle}">
                                        <Setter Property="Background" Value="{DynamicResource NeutralBadgeBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Billable}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BillableBadgeBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BillableLabel}" Style="{StaticResource BadgeTextStyle}" />
                            </Border>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource BadgeStyle}">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Visibility" Value="{Binding ShowSageBadge, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SagePosted}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SageBadge}" Style="{StaticResource BadgeTextStyle}" />
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}"
                                    Background="{DynamicResource NoTicketBadgeBrush}"
                                    Visibility="{Binding HasTicket, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <TextBlock Text="No Ticket" Style="{StaticResource BadgeTextStyle}" />
                            </Border>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource BadgeStyle}">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Setter Property="Visibility" Value="{Binding ShowWhdBadge, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WhdPosted}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding WhdBadge}" Style="{StaticResource BadgeTextStyle}" />
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}"
                                    Background="{DynamicResource WarningBrush}"
                                    Visibility="{Binding ModifiedAfterPosting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Modified After Posting" Style="{StaticResource BadgeTextStyle}" />
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}"
                                    Background="{DynamicResource NeutralBadgeBrush}"
                                    Visibility="{Binding HasTags, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding Tags}"
                                           Style="{StaticResource BadgeTextStyle}"
                                           MaxWidth="190"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border Visibility="{Binding HasFollowUp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource BadgeStyle}">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFollowUpOverdue}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding FollowUpBadge}" Style="{StaticResource BadgeTextStyle}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,20,16,16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Height="84" Margin="0,0,0,20">
                        <Image Source="Assets/csri-techbench-logo.png"
                               Stretch="Uniform"
                               HorizontalAlignment="Stretch"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>

                    <TextBlock Text="WORKLOG" Style="{StaticResource SidebarGroupLabelStyle}" />
                    <Button Content="Today" Command="{Binding NavigateCommand}" CommandParameter="Today" Style="{StaticResource NavTodayStyle}" />
                    <Button Content="This Week" Command="{Binding NavigateCommand}" CommandParameter="This Week" Style="{StaticResource NavWeekStyle}" />
                    <Button Content="History" Command="{Binding NavigateCommand}" CommandParameter="History" Style="{StaticResource NavHistoryStyle}" />
                    <Button Content="Search" Command="{Binding NavigateCommand}" CommandParameter="Search" Style="{StaticResource NavSearchStyle}" />
                    <Button Content="Posting Queue" Command="{Binding NavigateCommand}" CommandParameter="Posting Queue" Style="{StaticResource NavQueueStyle}" />

                    <TextBlock Text="DIRECTORY" Style="{StaticResource SidebarGroupLabelStyle}" />
                    <Button Content="Clients" Command="{Binding NavigateCommand}" CommandParameter="Client List" Style="{StaticResource NavClientsStyle}" />
                    <Button Content="Tickets" Command="{Binding NavigateCommand}" CommandParameter="Ticket List" Style="{StaticResource NavTicketsStyle}" />
                    <Button Content="Links" Command="{Binding NavigateCommand}" CommandParameter="Common Links" Style="{StaticResource NavLinksStyle}" />
                    <Button Content="Client Credentials" Command="{Binding NavigateCommand}" CommandParameter="Client Credentials" Style="{StaticResource NavCredentialsStyle}"
                            Visibility="{Binding CanAccessFireDrill, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock Text="SYSTEM" Style="{StaticResource SidebarGroupLabelStyle}" />
                    <Button Content="Posting History" Command="{Binding NavigateCommand}" CommandParameter="Posting History" Style="{StaticResource NavPostingHistoryStyle}" />
                    <Button Content="Admin Center"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Admin Center"
                            Style="{StaticResource NavAdminCenterStyle}"
                            Visibility="{Binding CanAccessAdminCenter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavSettingsStyle}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7"><Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock Text="SHARED SQL WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding StatusMessage}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding DatabasePath}"
                               Foreground="{DynamicResource SidebarMutedTextBrush}"
                               FontSize="9"
                               ToolTip="{Binding DatabasePath}"
                               TextTrimming="CharacterEllipsis"
                               Margin="5,9,5,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="88" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="26,0" Background="{DynamicResource HeaderBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="{Binding CurrentSection}"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Command="{Binding Updates.ShowUpdateBannerCommand}"
                                Style="{StaticResource HeaderUpdateButtonStyle}"
                                ToolTip="{Binding Updates.BannerTitle}"
                                AutomationProperties.Name="{Binding Updates.BannerTitle}"
                                Margin="0,0,10,0"
                                Visibility="{Binding Updates.HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2193;"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           Margin="0,-2,7,0" />
                                <TextBlock Text="{Binding Updates.HeaderUpdateLabel}"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="13,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Editor.IsDirty}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEntryOperationRunning}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentHoverBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding WorkspaceStateLabel}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1">
                <Border Background="{DynamicResource WarningBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="24,12"
                        Visibility="{Binding IsReadOnlyPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ReadOnlyPreviewLabel}"
                               Foreground="White"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                </Border>

                <Border BorderThickness="0,0,0,1"
                        Padding="24,12"
                        Visibility="{Binding Updates.IsBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Updates.IsUpdateCompletion}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Updates.BannerTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <TextBlock Text="{Binding Updates.BannerDetail}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                        <Grid Margin="0,9,0,0"
                              Visibility="{Binding Updates.IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding Updates.DownloadProgress, Mode=OneWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Updates.DownloadProgressLabel}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="10,-4,0,0" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Update now"
                                Command="{Binding Updates.InstallUpdateCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="108"
                                Margin="0,0,8,0"
                                Visibility="{Binding Updates.IsUpdateActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="{Binding Updates.DismissButtonText}"
                                Command="{Binding Updates.DismissBannerCommand}"
                                MinWidth="72" />
                    </StackPanel>
                </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="24">
                <Grid Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Today}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="New Entry"
                                        Command="{Binding NewEntryCommand}"
                                        Click="NewEntryButton_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                            <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="Billable " Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding TotalBillableLabel}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="Non-billable " Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding TotalNonBillableLabel}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="WHD pending " Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding WhdPendingCount}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Sage pending " Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding SagePendingCount}" FontWeight="SemiBold" />
                                </StackPanel>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Style="{StaticResource CardStyle}"
                            Margin="0,0,0,14"
                            Visibility="{Binding HasCloseoutIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="Daily Closeout"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Items requiring attention"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding DailyCloseoutItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectCloseoutIssueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Padding="0"
                                                Margin="0,0,10,10"
                                                MinWidth="150"
                                                HorizontalContentAlignment="Stretch">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIssue}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Border Padding="12,10">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock Text="{Binding Label}"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding Value}"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   Margin="10,0,0,0" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Detail}"
                                                               Style="{StaticResource MutedTextStyle}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="0.95*" MinWidth="420" />
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding Entries}"
                                 SelectedItem="{Binding SelectedEntry}"
                                 ItemTemplate="{StaticResource EntryCardTemplate}"
                                 Style="{StaticResource ListBoxChromeLessStyle}"
                                 ItemContainerStyle="{StaticResource ListBoxItemCardStyle}" />

                        <StackPanel Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasTodayEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="No entries for this day"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <Button Content="New Entry"
                                    Command="{Binding NewEntryCommand}"
                                    Click="NewEntryButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0" />
                        </StackPanel>

                        <GridSplitter Grid.Column="1"
                                      Width="6"
                                      HorizontalAlignment="Center"
                                      Background="{DynamicResource BorderBrush}" />

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding EditorTitle}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding EditorSubtitle}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource BadgeStyle}">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Editor.IsDirty}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EditorSaveStatus}" Style="{StaticResource BadgeTextStyle}" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}"
                                                Background="{DynamicResource NeutralBadgeBrush}"
                                                Visibility="{Binding IsEditorLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Sage posted / locked" Style="{StaticResource BadgeTextStyle}" />
                                        </Border>
                                    </WrapPanel>
                                </Grid>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,0,0,12"
                                        Visibility="{Binding IsEntryOperationRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel>
                                        <ProgressBar DockPanel.Dock="Left"
                                                     IsIndeterminate="True"
                                                     Width="72"
                                                     Height="5"
                                                     Margin="0,0,12,0"
                                                     VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding EntryOperationText}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </DockPanel>
                                </Border>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,6,0">
                                        <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                                BorderBrush="{DynamicResource WarningBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,12"
                                                Visibility="{Binding IsEditorLocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="This entry is permanently locked because it was posted to Sage."
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Width="220"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,0,0,12"
                                                    IsEnabled="{Binding IsEditorEditable}">
                                            <TextBlock Text="Work date" Style="{StaticResource FieldLabelStyle}" />
                                            <DatePicker SelectedDate="{Binding Editor.WorkDate}"
                                                        SelectedDateFormat="Short" />
                                        </StackPanel>

                                        <Grid Margin="0,0,0,12" IsEnabled="{Binding IsEditorEditable}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Client" Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox x:Name="EditorClientComboBox"
                                                          ItemsSource="{Binding EditorClients}"
                                                          SelectedItem="{Binding Editor.SelectedClient}"
                                                          Text="{Binding EditorClientFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                          TextSearch.TextPath="DisplayName"
                                                          IsDropDownOpen="{Binding IsEditorClientDropDownOpen}"
                                                          ItemTemplate="{StaticResource EditorClientOptionTemplate}"
                                                          ItemContainerStyle="{StaticResource EditorClientComboBoxItemStyle}"
                                                          MaxDropDownHeight="260">
                                                    <ComboBox.Style>
                                                        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource SearchableComboBoxStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Editor.UseManualClient}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                                <CheckBox Content="Use custom client"
                                                          IsChecked="{Binding Editor.UseManualClient}"
                                                          Margin="1,7,0,0" />
                                                <StackPanel Margin="0,6,0,0"
                                                            Visibility="{Binding Editor.UseManualClient, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Custom client / contact" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Editor.ManualClientName, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Ticket" Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox ItemsSource="{Binding TicketsForEditor}"
                                                          SelectedItem="{Binding Editor.SelectedTicket}"
                                                          ItemTemplate="{StaticResource TicketSelectorItemTemplate}"
                                                          MaxDropDownHeight="280">
                                                    <ComboBox.Style>
                                                        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Editor.UseOtherWhdTicket}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                                <CheckBox Content="Use another WHD ticket"
                                                          IsChecked="{Binding Editor.UseOtherWhdTicket}"
                                                          Margin="1,7,0,0" />
                                                <StackPanel Margin="0,6,0,0"
                                                            Visibility="{Binding Editor.UseOtherWhdTicket, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="WHD ticket number" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Text="{Binding Editor.ManualTicketNumber, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="20"
                                                             ToolTip="Closed or other authorized WHD ticket number" />
                                                </StackPanel>
                                                <StackPanel Margin="0,8,0,0"
                                                            Visibility="{Binding Editor.HasSelectedSyncedTicket, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Editor.SelectedTicket.Status, StringFormat=Current status: {0}}"
                                                               Style="{StaticResource MutedTextStyle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               Margin="1,0,0,5" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox ItemsSource="{Binding TicketStatusOptions}"
                                                                  SelectedItem="{Binding SelectedTicketStatus}"
                                                                  ItemTemplate="{StaticResource TicketStatusOptionTemplate}" />
                                                        <Button Grid.Column="2"
                                                                Content="Apply"
                                                                Command="{Binding ChangeTicketStatusCommand}"
                                                                CommandParameter="{Binding Editor.SelectedTicket}"
                                                                MinWidth="70"
                                                                Padding="10,7" />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Sage/WHD Note" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Editor.NoteCountLabel}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Margin="12,0,1,7" />
                                        </Grid>
                                        <TextBox Text="{Binding Editor.Note, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 SpellCheck.IsEnabled="True"
                                                 UndoLimit="200"
                                                 MinHeight="240"
                                                 IsReadOnly="{Binding IsEditorReadOnly}" />

                                        <Grid IsEnabled="{Binding IsEditorEditable}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,12,0,0">
                                                <CheckBox Content="Billable" IsChecked="{Binding Editor.Billable}" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                                <TextBlock Text="Time" Style="{StaticResource FieldLabelStyle}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                                        <TextBlock Text="Start" Style="{StaticResource MutedTextStyle}" Margin="1,0,0,5" />
                                                        <ComboBox ItemsSource="{Binding Editor.TimeOptions}"
                                                                  SelectedValue="{Binding Editor.StartTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Value"
                                                                  DisplayMemberPath="DisplayText"
                                                                  Text="{Binding Editor.StartTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEditable="True"
                                                                  IsTextSearchEnabled="False"
                                                                  StaysOpenOnEdit="True"
                                                                  MaxDropDownHeight="320"
                                                                  ToolTip="Choose or type the time work started." />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                                        <TextBlock Text="End" Style="{StaticResource MutedTextStyle}" Margin="1,0,0,5" />
                                                        <ComboBox ItemsSource="{Binding Editor.TimeOptions}"
                                                                  SelectedValue="{Binding Editor.EndTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  SelectedValuePath="Value"
                                                                  DisplayMemberPath="DisplayText"
                                                                  Text="{Binding Editor.EndTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEditable="True"
                                                                  IsTextSearchEnabled="False"
                                                                  StaysOpenOnEdit="True"
                                                                  MaxDropDownHeight="320"
                                                                  ToolTip="Choose or type the time work ended." />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                                                        <TextBlock Text="Hours" Style="{StaticResource MutedTextStyle}" Margin="1,0,0,5" />
                                                        <TextBox Text="{Binding Editor.DurationHoursText, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsReadOnly="{Binding Editor.IsDurationCalculated}"
                                                                 ToolTip="Calculated automatically when both times are entered." />
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                                                        <TextBlock Text="Minutes" Style="{StaticResource MutedTextStyle}" Margin="1,0,0,5" />
                                                        <TextBox Text="{Binding Editor.DurationMinutePartText, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsReadOnly="{Binding Editor.IsDurationCalculated}"
                                                                 ToolTip="Enter a value from 0 to 59." />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Margin="0,12,0,0">
                                            <WrapPanel>
                                                <Border Style="{StaticResource BadgeStyle}"
                                                        Background="{DynamicResource NoTicketBadgeBrush}"
                                                        Visibility="{Binding Editor.HasNoTicket, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Editor.TicketWarningText}" Style="{StaticResource BadgeTextStyle}" />
                                                </Border>
                                                <Border Style="{StaticResource BadgeStyle}"
                                                        Background="{DynamicResource WarningBrush}"
                                                        Visibility="{Binding Editor.ModifiedAfterPosting, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Modified After Posting" Style="{StaticResource BadgeTextStyle}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Editor.LastError}"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       Visibility="{Binding Editor.LastError, Converter={StaticResource StringToVisibilityConverter}}"
                                                       Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Editor.PostingSuccessMessage}"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       FontWeight="SemiBold"
                                                       Visibility="{Binding Editor.HasPostingSuccess, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>

                                        <Grid Margin="0,12,0,0" IsEnabled="{Binding IsEditorEditable}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="180" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Tags" Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox ItemsSource="{Binding TagSuggestions}"
                                                          Text="{Binding Editor.Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True"
                                                          IsTextSearchEnabled="True"
                                                          StaysOpenOnEdit="True"
                                                          ToolTip="Type a tag or choose one you have used before. Separate multiple tags with commas." />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Follow-up" Style="{StaticResource FieldLabelStyle}" />
                                                <ComboBox ItemsSource="{Binding FollowUpOptions}"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectedValuePath="Value"
                                                          SelectedValue="{Binding Editor.FollowUpState}" />
                                            </StackPanel>
                                        </Grid>

                                        <Expander Header="{Binding Editor.InternalNoteHeader}"
                                                  Margin="0,10,0,0">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Personal Note Markdown"
                                                                   Style="{StaticResource FieldLabelStyle}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="1,0,0,0" />
                                                        <CheckBox Content="Include Personal Note when posting to WHD"
                                                                  IsChecked="{Binding Editor.IncludePersonalNoteInWhd}"
                                                                  IsEnabled="{Binding IsEditorEditable}"
                                                                  Margin="1,6,0,0"
                                                                  ToolTip="Off by default. Sage never receives the Personal Note." />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="Open Personal Note Editor"
                                                            MinWidth="154"
                                                            Padding="11,6"
                                                            Click="OpenInternalMarkdownEditor_Click" />
                                                </Grid>
                                                <TextBox Grid.Row="1"
                                                         Text="{Binding Editor.InternalNote, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         AcceptsTab="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Disabled"
                                                         SpellCheck.IsEnabled="True"
                                                         UndoLimit="200"
                                                         IsReadOnly="{Binding IsEditorReadOnly}"
                                                         IsReadOnlyCaretVisible="True"
                                                         FontFamily="Cascadia Mono, Consolas"
                                                         MinHeight="110"
                                                         Margin="0,8,0,0" />
                                            </Grid>
                                        </Expander>

                                        <Expander Header="{Binding RelatedNotesHeader}"
                                                  Margin="0,10,0,0"
                                                  IsExpanded="{Binding HasPendingFollowUp, Mode=OneWay}"
                                                  Visibility="{Binding ShowRelatedNotesSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel Margin="0,8,0,0">
                                                <Border Background="{DynamicResource AccentSoftBrush}"
                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,8"
                                                        Margin="0,0,0,9"
                                                        Visibility="{Binding HasPendingFollowUp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="This will be a follow-up to"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding PendingFollowUpSource.ClientDisplay}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,3,0,0" />
                                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding PendingFollowUpSource.WorkDate, Mode=OneWay, StringFormat={}{0:M/d/yyyy}}" />
                                                                <Run Text="  /  " />
                                                                <Run Text="{Binding PendingFollowUpSource.TicketDisplay, Mode=OneWay}" />
                                                                <Run Text="  /  " />
                                                                <Run Text="{Binding PendingFollowUpSource.NotePreview, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="Cancel link"
                                                                Command="{Binding CancelPendingNoteLinkCommand}"
                                                                Padding="9,4"
                                                                MinHeight="28"
                                                                Margin="12,0,0,0"
                                                                VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <ItemsControl ItemsSource="{Binding RelatedNotes}"
                                                              Visibility="{Binding HasRelatedNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="0,0,0,8"
                                                                    Margin="0,0,0,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="96" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0"
                                                                            Style="{StaticResource BadgeStyle}"
                                                                            Background="{DynamicResource NeutralBadgeBrush}"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Top">
                                                                        <TextBlock Text="{Binding RelationshipLabel}"
                                                                                   Style="{StaticResource BadgeTextStyle}" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Margin="8,0,10,0">
                                                                        <TextBlock Text="{Binding RelatedEntry.ClientDisplay}"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                                                   FontSize="11"
                                                                                   TextTrimming="CharacterEllipsis">
                                                                            <Run Text="{Binding RelatedEntry.WorkDate, Mode=OneWay, StringFormat={}{0:M/d/yyyy}}" />
                                                                            <Run Text="  /  " />
                                                                            <Run Text="{Binding RelatedEntry.TicketDisplay, Mode=OneWay}" />
                                                                            <Run Text="  /  " />
                                                                            <Run Text="{Binding RelatedEntry.NotePreview, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="2"
                                                                            Content="Open"
                                                                            Command="{Binding DataContext.OpenRelatedNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Padding="9,4"
                                                                            MinHeight="28"
                                                                            VerticalAlignment="Center"
                                                                            Margin="0,0,7,0" />
                                                                    <Button Grid.Column="3"
                                                                            Content="Remove"
                                                                            Command="{Binding DataContext.RemoveNoteLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Padding="9,4"
                                                                            MinHeight="28"
                                                                            VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <WrapPanel Visibility="{Binding Editor.IsExistingEntry, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Button Content="{Binding NoteLinkPickerButtonLabel}"
                                                            Command="{Binding ToggleNoteLinkPickerCommand}"
                                                            Padding="11,5"
                                                            MinHeight="30"
                                                            Margin="0,0,8,0" />
                                                    <Button Content="Continue this work"
                                                            Command="{Binding ContinueThisWorkCommand}"
                                                            Padding="11,5"
                                                            MinHeight="30" />
                                                </WrapPanel>

                                                <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10"
                                                        Margin="0,9,0,0"
                                                        Visibility="{Binding IsNoteLinkPickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="150" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="Find by client, ticket, or note text"
                                                                           Style="{StaticResource FieldLabelStyle}" />
                                                                <TextBox Text="{Binding NoteLinkSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="Relationship"
                                                                           Style="{StaticResource FieldLabelStyle}" />
                                                                <ComboBox ItemsSource="{Binding NoteLinkTypeOptions}"
                                                                          DisplayMemberPath="DisplayName"
                                                                          SelectedItem="{Binding SelectedNoteLinkTypeOption}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock Text="Suggested notes"
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   Margin="1,9,0,6" />
                                                        <TextBlock Text="No matching notes found."
                                                                   Style="{StaticResource MutedTextStyle}"
                                                                   Margin="1,4,0,3"
                                                                   Visibility="{Binding HasNoteLinkCandidates, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                        <ScrollViewer MaxHeight="270"
                                                                      VerticalScrollBarVisibility="Auto"
                                                                      Visibility="{Binding HasNoteLinkCandidates, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ItemsControl ItemsSource="{Binding NoteLinkCandidates}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,8">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="82" />
                                                                                <ColumnDefinition Width="150" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding WorkDate, StringFormat={}{0:M/d/yyyy}}"
                                                                                       Style="{StaticResource MutedTextStyle}"
                                                                                       VerticalAlignment="Center" />
                                                                            <StackPanel Grid.Column="1" Margin="7,0,10,0">
                                                                                <TextBlock Text="{Binding ClientDisplay}"
                                                                                           FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{Binding TicketDisplay}"
                                                                                           Style="{StaticResource MutedTextStyle}"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding DisplayPreview}"
                                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="0,0,10,0" />
                                                                            <Button Grid.Column="3"
                                                                                    Content="Link"
                                                                                    Command="{Binding DataContext.LinkExistingNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Padding="9,4"
                                                                                    MinHeight="28"
                                                                                    VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Expander>

                                        <Expander Header="{Binding RecentClientNotesHeader}"
                                                  Margin="0,10,0,0"
                                                  Visibility="{Binding HasRecentClientEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl ItemsSource="{Binding RecentClientEntries}" Margin="0,7,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="82" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding WorkDate, StringFormat={}{0:M/d/yyyy}}"
                                                                       Style="{StaticResource MutedTextStyle}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding NotePreview}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="8,0" />
                                                            <Button Grid.Column="2"
                                                                    Content="Insert"
                                                                    Command="{Binding DataContext.InsertRecentNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="9,4"
                                                                    MinHeight="28" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>

                                <Border Grid.Row="3"
                                        Background="{DynamicResource PanelAltBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding HasUndoDelete, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding UndoDeleteLabel}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                        <Button Grid.Column="1"
                                                Content="Undo"
                                                Command="{Binding UndoDeleteCommand}"
                                                MinHeight="32"
                                                Padding="12,5"
                                                Margin="12,0,0,0" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="4" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StatusMessage}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               ToolTip="{Binding StatusMessage}"
                                               Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Open WHD"
                                                Command="{Binding OpenWhdTicketCommand}"
                                                Style="{StaticResource EditorActionButtonStyle}"
                                                Visibility="{Binding ShowOpenWhdAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Content="Save"
                                                Command="{Binding SaveEntryCommand}"
                                                Style="{StaticResource EditorActionButtonStyle}"
                                                ToolTip="Save and start a new entry (Ctrl+S)" />
                                        <Button Content="Post"
                                                Click="PostActionsButton_Click"
                                                Style="{StaticResource EditorActionButtonStyle}"
                                                MinWidth="76"
                                                ToolTip="Save locally, then choose where to post">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource EditorContextMenuStyle}"
                                                             Placement="Top"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{Binding WhdPostActionLabel}"
                                                              Command="{Binding PostWhdCommand}"
                                                              Style="{StaticResource EditorContextMenuItemStyle}" />
                                                    <MenuItem Header="Create Sage Ticket"
                                                              Command="{Binding PostSageCommand}"
                                                              Style="{StaticResource EditorContextMenuItemStyle}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                        <Button Content="More"
                                                Click="MoreActionsButton_Click"
                                                Style="{StaticResource EditorActionButtonStyle}"
                                                MinWidth="76">
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource EditorContextMenuStyle}"
                                                             Placement="Top"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Link Existing Sage Ticket..."
                                                              Command="{Binding LinkSageTicketCommand}"
                                                              Style="{StaticResource EditorContextMenuItemStyle}" />
                                                    <MenuItem Header="Sync WHD Note"
                                                              Command="{Binding SyncWhdNoteCommand}"
                                                              Style="{StaticResource EditorContextMenuItemStyle}" />
                                                    <MenuItem Header="Mark WHD Posted (Manual)"
                                                              Command="{Binding MarkWhdPostedCommand}"
                                                              Style="{StaticResource EditorContextMenuItemStyle}" />
                                                    <Separator />
                                                    <MenuItem Header="Duplicate Entry"
                                                              Command="{Binding DuplicateEntryCommand}"
                                                              Style="{StaticResource EditorContextMenuItemStyle}" />
                                                    <MenuItem Header="Delete Entry"
                                                              Command="{Binding DeleteEntryCommand}"
                                                              Foreground="{DynamicResource DangerBrush}"
                                                              Style="{StaticResource EditorContextMenuItemStyle}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <ScrollViewer Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=This Week}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <DatePicker SelectedDate="{Binding SelectedDate}"
                                                SelectedDateFormat="Short"
                                                Width="140"
                                                Margin="0,0,10,0" />
                                    <Button Content="Export Week" Command="{Binding ExportWeeklyCsvCommand}" />
                                </StackPanel>
                                <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                        <TextBlock Text="Week total " Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding WeekTotalLabel}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                        <TextBlock Text="Billable " Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding WeekBillableLabel}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Non-billable " Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding WeekNonBillableLabel}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding WeekGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Header}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <WrapPanel Grid.Column="1"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="24,0,0,0"
                                                           ItemHeight="20">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                                        <TextBlock Text="Total " Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Text="{Binding TotalLabel}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                                        <TextBlock Text="Billable " Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Text="{Binding BillableLabel}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Non-billable " Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Text="{Binding NonBillableLabel}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </WrapPanel>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding DayGroups}"
                                                          Visibility="{Binding HasDayGroups, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="12"
                                                                Margin="0,0,0,10">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Header}"
                                                                               FontSize="15"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <WrapPanel Grid.Column="1"
                                                                               HorizontalAlignment="Right"
                                                                               Margin="20,0,0,0">
                                                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                                            <TextBlock Text="Total " Foreground="{DynamicResource MutedTextBrush}" />
                                                                            <TextBlock Text="{Binding TotalLabel}" FontWeight="SemiBold" />
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                                            <TextBlock Text="Billable " Foreground="{DynamicResource MutedTextBrush}" />
                                                                            <TextBlock Text="{Binding BillableLabel}" FontWeight="SemiBold" />
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="Non-billable " Foreground="{DynamicResource MutedTextBrush}" />
                                                                            <TextBlock Text="{Binding NonBillableLabel}" FontWeight="SemiBold" />
                                                                        </StackPanel>
                                                                    </WrapPanel>
                                                                </Grid>

                                                                <ItemsControl ItemsSource="{Binding Entries}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Style="{StaticResource EntryCardButtonStyle}"
                                                                                    ToolTip="Open this entry in the editor">
                                                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryCardTemplate}" />
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding Entries}"
                                                          Visibility="{Binding HasDayGroups, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource EntryCardButtonStyle}"
                                                                ToolTip="Open this entry in the editor">
                                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryCardTemplate}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=History}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <DockPanel LastChildFill="True">
                                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Bottom" ItemHeight="62">
                                    <StackPanel Width="150" Margin="0,0,12,0">
                                        <TextBlock Text="Range" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding HistoryRangeOptions}"
                                                  SelectedItem="{Binding HistoryRangePreset}" />
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="0,0,12,0">
                                        <TextBlock Text="Group by" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding HistoryGroupOptions}"
                                                  SelectedItem="{Binding HistoryGroupBy}" />
                                    </StackPanel>
                                    <StackPanel Width="230" Margin="0,0,12,0">
                                        <TextBlock Text="View" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Grouped"
                                                         IsChecked="{Binding IsHistoryGroupedView}"
                                                         GroupName="HistoryViewMode"
                                                         Margin="0,4,16,0" />
                                            <RadioButton Content="Inline timeline"
                                                         IsChecked="{Binding IsHistoryInlineTimelineView}"
                                                         GroupName="HistoryViewMode"
                                                         Margin="0,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Width="132" Margin="0,0,12,0">
                                        <TextBlock Text="Start date" Style="{StaticResource FieldLabelStyle}" />
                                        <DatePicker SelectedDate="{Binding HistoryStartDate}"
                                                    SelectedDateFormat="Short" />
                                    </StackPanel>
                                    <StackPanel Width="132" Margin="0,0,12,0">
                                        <TextBlock Text="End date" Style="{StaticResource FieldLabelStyle}" />
                                        <DatePicker SelectedDate="{Binding HistoryEndDate}"
                                                    SelectedDateFormat="Short" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,23,0,0">
                                        <Button Content="Refresh"
                                                Command="{Binding RefreshHistoryCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                MinWidth="88"
                                                Margin="0,0,8,0" />
                                        <Button Content="Export CSV"
                                                Command="{Binding ExportHistoryCsvCommand}"
                                                MinWidth="96" />
                                    </StackPanel>
                                </WrapPanel>

                                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                        <TextBlock Text="{Binding HistoryEntryCountLabel}" Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                        <TextBlock Text="Total " Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding HistoryTotalLabel}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                        <TextBlock Text="Billable " Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding HistoryBillableLabel}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                        <TextBlock Text="Non-billable " Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding HistoryNonBillableLabel}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                        <TextBlock Text="WHD pending " Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding HistoryWhdPendingLabel}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Sage pending " Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding HistorySagePendingLabel}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </WrapPanel>
                            </DockPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding HistoryGroups}"
                                      Visibility="{Binding HistoryViewMode, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Grouped}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Header}"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DateRangeLabel}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            Margin="24,0,0,0">
                                                    <TextBlock Text="{Binding Summary}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextAlignment="Right"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding PostingSummary}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               TextAlignment="Right"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding DayGroups}"
                                                          Visibility="{Binding HasDayGroups, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="12"
                                                                Margin="0,0,0,10">
                                                            <StackPanel>
                                                                <Grid Margin="0,0,0,10">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Header}"
                                                                               FontSize="15"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="NoWrap"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <WrapPanel Grid.Column="1"
                                                                               HorizontalAlignment="Right"
                                                                               Margin="20,0,0,0">
                                                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                                            <TextBlock Text="Total " Foreground="{DynamicResource MutedTextBrush}" />
                                                                            <TextBlock Text="{Binding TotalLabel}" FontWeight="SemiBold" />
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                                            <TextBlock Text="Billable " Foreground="{DynamicResource MutedTextBrush}" />
                                                                            <TextBlock Text="{Binding BillableLabel}" FontWeight="SemiBold" />
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="Non-billable " Foreground="{DynamicResource MutedTextBrush}" />
                                                                            <TextBlock Text="{Binding NonBillableLabel}" FontWeight="SemiBold" />
                                                                        </StackPanel>
                                                                    </WrapPanel>
                                                                </Grid>

                                                                <ItemsControl ItemsSource="{Binding Entries}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Button Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Style="{StaticResource EntryCardButtonStyle}"
                                                                                    ToolTip="Open this entry in the editor">
                                                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryCardTemplate}" />
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding Entries}"
                                                          Visibility="{Binding HasDayGroups, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource EntryCardButtonStyle}"
                                                                ToolTip="Open this entry in the editor">
                                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryCardTemplate}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding HistoryTimelineGroups}"
                                      Visibility="{Binding HistoryViewMode, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Inline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,9"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Header}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <WrapPanel Grid.Column="1"
                                                           HorizontalAlignment="Right"
                                                           Margin="20,0,0,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                        <TextBlock Text="Total " Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Text="{Binding TotalLabel}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                        <TextBlock Text="Billable " Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Text="{Binding BillableLabel}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Non-billable " Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Text="{Binding NonBillableLabel}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource EntryCardButtonStyle}"
                                                            ToolTip="Open this entry in the editor">
                                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource EntryCardTemplate}" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Client List}">
                    <Border Style="{StaticResource CardStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Client Matching" Style="{StaticResource SectionHeadingStyle}" />
                                        <TextBlock Text="One TechBench client per customer, linked to its WHD location and Sage customer."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Margin="0,0,0,10" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Search clients" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding ClientSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                <WrapPanel Margin="0,0,0,12">
                                    <Border Style="{StaticResource BadgeStyle}" Background="{DynamicResource SuccessBrush}">
                                        <TextBlock Text="{Binding MatchedClientCountLabel}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeStyle}" Background="{DynamicResource WarningBrush}">
                                        <TextBlock Text="{Binding UnmatchedWhdClientCountLabel}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeStyle}" Background="{DynamicResource NoTicketBadgeBrush}">
                                        <TextBlock Text="{Binding UnmatchedSageClientCountLabel}" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </WrapPanel>

                                <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,0,0,12"
                                        Visibility="{Binding CanManageOrganizationSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Selected WHD location" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding ClientMatchSelectionLabel}"
                                                       Style="{StaticResource DetailValueStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ClientMatchSelectionLabel}" />
                                            <TextBlock Text="{Binding ClientMatchSuggestionText}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Sage customer" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox ItemsSource="{Binding SageMatchCandidates}"
                                                      SelectedItem="{Binding SelectedSageMatchCandidate}"
                                                      DisplayMemberPath="SageCustomerLabel"
                                                      IsTextSearchEnabled="True"
                                                      ToolTip="Choose the Sage customer that represents the same company." />
                                        </StackPanel>
                                        <Button Grid.Column="3"
                                                Content="Match"
                                                Command="{Binding ApplyClientMatchCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                MinWidth="88"
                                                Margin="12,20,0,0"
                                                VerticalAlignment="Top" />
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.7*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Client name" Style="{StaticResource TableHeaderTextStyle}" />
                                        <TextBlock Grid.Column="1" Text="Source" Style="{StaticResource TableHeaderTextStyle}" />
                                        <TextBlock Grid.Column="2" Text="WHD ID" Style="{StaticResource TableHeaderTextStyle}" />
                                        <TextBlock Grid.Column="3" Text="WHD location" Style="{StaticResource TableHeaderTextStyle}" />
                                        <TextBlock Grid.Column="4" Text="WHD contact" Style="{StaticResource TableHeaderTextStyle}" />
                                        <TextBlock Grid.Column="5" Text="Sage customer" Style="{StaticResource TableHeaderTextStyle}" />
                                        <TextBlock Grid.Column="6" Text="Match" Style="{StaticResource TableHeaderTextStyle}" />
                                        <TextBlock Grid.Column="7" Text="Last synced" Style="{StaticResource TableHeaderTextStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding ManagedClients}"
                                     SelectedItem="{Binding SelectedManagedClient}"
                                     Style="{StaticResource ListBoxChromeLessStyle}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.7*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="1.1*" />
                                                    <ColumnDefinition Width="1.6*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource DetailValueStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding SourceLabel}" Style="{StaticResource TableCellTextStyle}" />
                                                <TextBlock Grid.Column="2" Text="{Binding ExternalIdLabel}" Style="{StaticResource TableCellTextStyle}" />
                                                <TextBlock Grid.Column="3" Text="{Binding WhdLocationLabel}" Style="{StaticResource TableCellTextStyle}" />
                                                <TextBlock Grid.Column="4" Text="{Binding WhdContactLabel}" Style="{StaticResource TableCellTextStyle}" />
                                                <TextBlock Grid.Column="5" Text="{Binding SageCustomerLabel}" Style="{StaticResource TableCellTextStyle}" />
                                                <TextBlock Grid.Column="6" Text="{Binding MatchStatusLabel}" Style="{StaticResource TableCellTextStyle}" />
                                                <TextBlock Grid.Column="7" Text="{Binding LastSyncedLabel}" Style="{StaticResource TableCellTextStyle}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Ticket List}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Tickets" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Filter by client" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Clients}"
                                          SelectedItem="{Binding TicketClientFilter}"
                                          ItemTemplate="{StaticResource ClientOptionTemplate}"
                                          Margin="0,0,0,12" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Tickets}"
                                     SelectedItem="{Binding SelectedTicket}"
                                     Style="{StaticResource ListBoxChromeLessStyle}"
                                     ItemContainerStyle="{StaticResource ListBoxItemCardStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TicketNumber}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subject}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedTextStyle}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Ticket Status" Style="{StaticResource SectionHeadingStyle}" />
                            <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="12"
                                    Margin="0,0,0,18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Ticket" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding SelectedTicket.TicketNumber}"
                                                       Style="{StaticResource DetailValueStyle}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Current status" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding SelectedTicket.Status}"
                                                       Style="{StaticResource DetailValueStyle}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Subject" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedTicket.Subject}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="New status" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding TicketStatusOptions}"
                                              SelectedItem="{Binding SelectedTicketStatus}"
                                              ItemTemplate="{StaticResource TicketStatusOptionTemplate}"
                                              Margin="0,0,0,12" />
                                    <Button Content="Save Ticket Status"
                                            Command="{Binding ChangeTicketStatusCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,0,8" />
                                    <Button Content="Open in WHD"
                                            Command="{Binding OpenWhdTicketCommand}"
                                            CommandParameter="{Binding SelectedTicket}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Client Credentials}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Client Credentials" Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Search the server-synchronized client credentials. Passwords remain hidden until you explicitly reveal a client."
                                           Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding FireDrillSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search client name" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="Search" Command="{Binding SearchFireDrillCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="No matching credential clients."
                                       Style="{StaticResource MutedTextStyle}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasFireDrillCredentials, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                            <ListBox ItemsSource="{Binding FireDrillCredentials}"
                                     SelectedItem="{Binding SelectedFireDrillCredential}"
                                     Style="{StaticResource ListBoxChromeLessStyle}"
                                     ItemContainerStyle="{StaticResource ListBoxItemCardStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}">
                                            <TextBlock Text="{Binding ClientName}" FontWeight="SemiBold" FontSize="14" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedFireDrillCredential.ClientName, TargetNullValue=Select a client}"
                                               Style="{StaticResource SectionHeadingStyle}" Margin="0" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <Button Content="Hide" Command="{Binding HideFireDrillCommand}" Margin="0,0,8,0" />
                                    <Button Content="Reveal Credentials" Command="{Binding RevealFireDrillCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                </WrapPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <TextBlock Text="Select a client to view its credential fields."
                                           Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                                           Visibility="{Binding HasSelectedFireDrillCredential, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HasSelectedFireDrillCredential, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding FireDrillCredentialFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="6" Padding="12" Margin="0,0,0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Text="{Binding Value}" IsReadOnly="True" Margin="8,0"
                                                                 FontFamily="Consolas" VerticalContentAlignment="Center" />
                                                        <Button Grid.Column="2" Content="Copy"
                                                                Command="{Binding DataContext.CopyFireDrillFieldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding FieldName}" Padding="12,6"
                                                                Visibility="{Binding DataContext.IsFireDrillCredentialRevealed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Common Links}">
                    <Border Style="{StaticResource CardStyle}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Common Links"
                                       Style="{StaticResource SectionHeadingStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,12" />

                            <TextBlock Text="No shared common links saved."
                                       Style="{StaticResource MutedTextStyle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasCommonLinks, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                            <ListBox ItemsSource="{Binding CommonLinksView}"
                                     Style="{StaticResource ListBoxChromeLessStyle}"
                                     Visibility="{Binding HasCommonLinks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ControlAltBackgroundBrush}"
                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                        BorderThickness="4,0,0,0"
                                                        CornerRadius="6"
                                                        Margin="4,18,4,6"
                                                        Padding="12,9">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               FontSize="15"
                                                               FontWeight="Bold" />
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="IsTabStop" Value="False" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="8,14">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlAltBackgroundBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="48"
                                                        Height="48"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="#F7F9FC"
                                                        BorderBrush="#D8E0EA"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                    <Grid>
                                                        <Image Stretch="Uniform"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Style>
                                                                <Style TargetType="{x:Type Image}">
                                                                    <Setter Property="Width" Value="36" />
                                                                    <Setter Property="Height" Value="36" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding BuiltInKey}" Value="watchguard-cloud">
                                                                            <Setter Property="Source" Value="Assets/common-link-watchguard.png" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BuiltInKey}" Value="microsoft-365-admin">
                                                                            <Setter Property="Source" Value="Assets/common-link-microsoft.png" />
                                                                            <Setter Property="Width" Value="24" />
                                                                            <Setter Property="Height" Value="24" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BuiltInKey}" Value="barracuda-cloud-control">
                                                                            <Setter Property="Source" Value="Assets/common-link-barracuda.png" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BuiltInKey}" Value="eset-protect">
                                                                            <Setter Property="Source" Value="Assets/common-link-eset.png" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BuiltInKey}" Value="email2phone">
                                                                            <Setter Property="Source" Value="Assets/common-link-email2phone.png" />
                                                                            <Setter Property="Width" Value="44" />
                                                                            <Setter Property="Height" Value="30" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BuiltInKey}" Value="godaddy-dns">
                                                                            <Setter Property="Source" Value="Assets/common-link-godaddy.ico" />
                                                                            <Setter Property="Width" Value="30" />
                                                                            <Setter Property="Height" Value="30" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BuiltInKey}" Value="network-solutions-dns">
                                                                            <Setter Property="Source" Value="Assets/common-link-network-solutions.png" />
                                                                            <Setter Property="Width" Value="42" />
                                                                            <Setter Property="Height" Value="30" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <TextBlock Text="{Binding DisplayInitial}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="19"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsBuiltIn, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,14,0">
                                                    <DockPanel LastChildFill="True">
                                                        <Border DockPanel.Dock="Right"
                                                                Style="{StaticResource BadgeStyle}"
                                                                Padding="7,3"
                                                                Margin="8,0,0,0"
                                                                Visibility="{Binding IsBuiltIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="BUILT IN"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       FontSize="9"
                                                                       FontWeight="Bold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding DisplayHost}"
                                                               Style="{StaticResource MutedTextStyle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right">
                                                        <Button Content="Open"
                                                                Command="{Binding DataContext.OpenCommonLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                MinWidth="68"
                                                                Padding="10,6" />
                                                    </StackPanel>
                                                    <CheckBox Content="Chrome Incognito"
                                                              IsChecked="{Binding DataContext.MicrosoftAdminOpenInChromeIncognito, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Right"
                                                              Margin="0,8,7,0"
                                                              ToolTip="Open Microsoft 365 Admin Center in a Chrome Incognito window">
                                                        <CheckBox.Style>
                                                            <Style TargetType="{x:Type CheckBox}"
                                                                   BasedOn="{StaticResource {x:Type CheckBox}}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding BuiltInKey}" Value="microsoft-365-admin">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                    </CheckBox>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Search}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <WrapPanel VerticalAlignment="Bottom" ItemHeight="62">
                            <StackPanel Width="220" Margin="0,0,12,0">
                                <TextBlock Text="Keyword" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="210" Margin="0,0,12,0">
                                <TextBlock Text="Client" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SearchClient}" ItemTemplate="{StaticResource ClientOptionTemplate}" />
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,12,0">
                                <TextBlock Text="Ticket" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding SearchTicketText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="135" Margin="0,0,12,0">
                                <TextBlock Text="Start date" Style="{StaticResource FieldLabelStyle}" />
                                <DatePicker SelectedDate="{Binding SearchStartDate}"
                                            SelectedDateFormat="Short" />
                            </StackPanel>
                            <StackPanel Width="160" Margin="0,0,12,0">
                                <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SearchStatusFilter}" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,0">
                                <TextBlock Text="Tags" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding TagSuggestions}"
                                          Text="{Binding SearchTags, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True" />
                            </StackPanel>
                            <StackPanel Width="150" Margin="0,0,12,0">
                                <TextBlock Text="Follow-up" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox ItemsSource="{Binding SearchFollowUpOptions}"
                                          SelectedItem="{Binding SearchFollowUpOption}"
                                          DisplayMemberPath="DisplayName" />
                            </StackPanel>
                            <StackPanel Width="135" Margin="0,0,12,0">
                                <TextBlock Text="End date" Style="{StaticResource FieldLabelStyle}" />
                                <DatePicker SelectedDate="{Binding SearchEndDate}"
                                            SelectedDateFormat="Short" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,23,0,0">
                                <CheckBox Content="Open follow-ups"
                                          IsChecked="{Binding SearchOpenFollowUpsOnly}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />
                                <Button Content="Search" Command="{Binding RunSearchCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                                <Button Content="Clear" Command="{Binding ClearSearchCommand}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="0.9*" MinWidth="420" />
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding SearchResults}"
                                 SelectedItem="{Binding SelectedEntry}"
                                 ItemTemplate="{StaticResource EntryCardTemplate}"
                                 Style="{StaticResource ListBoxChromeLessStyle}"
                                 ItemContainerStyle="{StaticResource ListBoxItemCardStyle}" />

                        <GridSplitter Grid.Column="1"
                                      Width="6"
                                      HorizontalAlignment="Center"
                                      Background="{DynamicResource BorderBrush}" />

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Entry Details"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding SelectedEntry.ClientDisplay}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SelectedEntry.TicketDisplay}"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="0,3,0,0"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Open WHD"
                                                    Command="{Binding OpenWhdTicketCommand}"
                                                    CommandParameter="{Binding SelectedEntry}"
                                                    MinWidth="104"
                                                    Margin="0,0,8,0" />
                                            <Button Content="Open in Editor"
                                                    Command="{Binding EditEntryCommand}"
                                                    CommandParameter="{Binding SelectedEntry}"
                                                    MinWidth="130" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,18,12">
                                                <TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedEntry.WorkDate, StringFormat={}{0:M/d/yyyy}}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedEntry.PostingStatusLabel}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,18,12">
                                                <TextBlock Text="Duration" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedEntry.DurationLabel}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Time" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedEntry.TimeRange}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,18,12">
                                                <TextBlock Text="Billing" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedEntry.BillableLabel}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Ticket subject" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedEntry.TicketSubject}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,18,12"
                                                        Visibility="{Binding SelectedEntry.ShowWhdBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="WHD" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedEntry.WhdBadge}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Sage" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedEntry.SageBadge}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="Created" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedEntry.CreatedAt, StringFormat={}{0:g}}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Updated" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedEntry.UpdatedAt, StringFormat={}{0:g}}" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>

                                    <TextBlock Text="{Binding SelectedEntry.LastError}"
                                               Foreground="{DynamicResource DangerBrush}"
                                               Visibility="{Binding SelectedEntry.LastError, Converter={StaticResource StringToVisibilityConverter}}"
                                               Margin="0,12,0,0" />

                                    <TextBlock Text="Sage/WHD Note" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,0" />
                                    <Border Background="{DynamicResource ControlBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10"
                                            MinHeight="170">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                                            <TextBlock Text="{Binding SelectedEntry.Note}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </ScrollViewer>
                                    </Border>

                                    <StackPanel Visibility="{Binding SelectedEntry.InternalNote, Converter={StaticResource StringToVisibilityConverter}}"
                                                Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Personal Note (Markdown)"
                                                       Style="{StaticResource FieldLabelStyle}"
                                                       VerticalAlignment="Center" />
                                                <TextBlock Text="Included in WHD"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Visibility="{Binding SelectedEntry.IncludePersonalNoteInWhd, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Open"
                                                    MinWidth="68"
                                                    Padding="10,5"
                                                    Margin="0,0,0,7"
                                                    Click="OpenHistoryMarkdownViewer_Click" />
                                        </Grid>
                                        <Border Background="{DynamicResource ControlBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10"
                                                MinHeight="110">
                                            <controls:MarkdownViewer Markdown="{Binding SelectedEntry.InternalNote}"
                                                                     BaseFontSize="13"
                                                                     MaxHeight="320" />
                                        </Border>
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Posting Queue}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <DockPanel LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button Content="Select All"
                                        Command="{Binding SelectAllPostingQueueCommand}"
                                        MinWidth="96"
                                        Margin="0,0,8,0" />
                                <Button Content="Clear"
                                        Command="{Binding ClearPostingQueueSelectionCommand}"
                                        MinWidth="80"
                                        Margin="0,0,8,0" />
                                <Button Content="Select Failed"
                                        Command="{Binding SelectFailedPostingQueueCommand}"
                                        MinWidth="104"
                                        Margin="0,0,14,0" />
                                <Button Content="Post Selected WHD"
                                        Command="{Binding BatchPostWhdCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="142"
                                        Margin="0,0,8,0" />
                            </WrapPanel>
                            <TextBlock Text="{Binding PostingQueue.Count, StringFormat={}{0} pending}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding PostingQueue}"
                             Style="{StaticResource ListBoxChromeLessStyle}"
                             ItemContainerStyle="{StaticResource ListBoxItemCardStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelectedForBatch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0" />
                                        <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource EntryCardTemplate}" />
                                        <StackPanel Grid.Column="2" Width="116" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <Button Content="Open WHD"
                                                    Command="{Binding DataContext.OpenWhdTicketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,0,8"
                                                    Visibility="{Binding HasTicket, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button Content="Post WHD"
                                                    Command="{Binding DataContext.PostWhdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,0,8"
                                                    Visibility="{Binding HasTicket, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button Content="Create Sage"
                                                    Command="{Binding DataContext.PostSageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasPostingQueueEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="Posting queue is clear"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="No WHD or Sage work is waiting."
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Posting History}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                        <DockPanel LastChildFill="True">
                            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Bottom" ItemHeight="62">
                                <StackPanel Width="260" Margin="0,0,12,0">
                                    <TextBlock Text="Keyword" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox Text="{Binding PostingLogKeyword, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Width="120" Margin="0,0,12,0">
                                    <TextBlock Text="Destination" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding PostingLogDestinationOptions}" SelectedItem="{Binding PostingLogDestinationFilter}" />
                                </StackPanel>
                                <StackPanel Width="120" Margin="0,0,12,0">
                                    <TextBlock Text="Result" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding PostingLogResultOptions}" SelectedItem="{Binding PostingLogResultFilter}" />
                                </StackPanel>
                                <StackPanel Width="135" Margin="0,0,12,0">
                                    <TextBlock Text="Start date" Style="{StaticResource FieldLabelStyle}" />
                                    <DatePicker SelectedDate="{Binding PostingLogStartDate}"
                                                SelectedDateFormat="Short" />
                                </StackPanel>
                                <StackPanel Width="135" Margin="0,0,12,0">
                                    <TextBlock Text="End date" Style="{StaticResource FieldLabelStyle}" />
                                    <DatePicker SelectedDate="{Binding PostingLogEndDate}"
                                                SelectedDateFormat="Short" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,23,0,0">
                                    <Button Content="Refresh"
                                            Command="{Binding RefreshPostingLogsCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Clear"
                                            Command="{Binding ClearPostingLogFiltersCommand}" />
                                </StackPanel>
                            </WrapPanel>

                            <TextBlock Text="{Binding PostingLogs.Count, StringFormat={}{0} log rows}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" MinWidth="430" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.1*" MinWidth="500" />
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding PostingLogs}"
                                 SelectedItem="{Binding SelectedPostingLog}"
                                 Style="{StaticResource ListBoxChromeLessStyle}"
                                 ItemContainerStyle="{StaticResource ListBoxItemCardStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SelectableEntryCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <WrapPanel Margin="0,0,0,8">
                                                    <Border Style="{StaticResource BadgeStyle}" Background="{DynamicResource NeutralBadgeBrush}">
                                                        <TextBlock Text="{Binding Destination}" Style="{StaticResource BadgeTextStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeStyle}"
                                                            Background="{DynamicResource SuccessBrush}"
                                                            Visibility="{Binding Success, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Success" Style="{StaticResource BadgeTextStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource BadgeStyle}"
                                                            Background="{DynamicResource DangerBrush}"
                                                            Visibility="{Binding Success, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Failed" Style="{StaticResource BadgeTextStyle}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding MessagePreview}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,7" />
                                                <TextBlock Text="{Binding PayloadPreview}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="42" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" Width="132">
                                                <TextBlock Text="{Binding CreatedLabel}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextAlignment="Right"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding EntryLabel}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           TextAlignment="Right"
                                                           Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <GridSplitter Grid.Column="1"
                                      Width="6"
                                      HorizontalAlignment="Center"
                                      Background="{DynamicResource BorderBrush}" />

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Posting Detail"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding SelectedPostingLog.CreatedLabel}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="Open Entry"
                                                Command="{Binding OpenPostingLogEntryCommand}"
                                                CommandParameter="{Binding SelectedPostingLog}"
                                                MinWidth="118"
                                                VerticalAlignment="Top" />
                                    </Grid>

                                    <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12">
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,18,12">
                                                <TextBlock Text="Entry" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedPostingLog.EntryLabel}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Result" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedPostingLog.ResultLabel}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="Destination" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedPostingLog.Destination}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Log ID" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedPostingLog.Id}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,12,18,0">
                                                <TextBlock Text="External reference" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBlock Text="{Binding SelectedPostingLog.ExternalReferenceLabel}" Style="{StaticResource DetailValueStyle}" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>

                                    <TextBlock Text="Message" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" />
                                    <Border Background="{DynamicResource ControlBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10"
                                            MinHeight="92">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170">
                                            <TextBlock Text="{Binding SelectedPostingLog.Message}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>

                                    <TextBlock Text="Payload / request detail" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" />
                                    <Border Background="{DynamicResource ControlBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="10"
                                            MinHeight="180">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                            <TextBlock Text="{Binding SelectedPostingLog.Payload}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <ScrollViewer Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Admin Center}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Web Help Desk synchronization" Style="{StaticResource SectionHeadingStyle}" />
                                    <TextBlock Text="{Binding AdminWhdSyncSummary}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,6" />
                                    <TextBlock Text="{Binding AdminWhdSyncDetails}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,0,0,14" />
                                    <Button Content="Sync WHD tickets now"
                                            Command="{Binding RequestAdminWhdSyncCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Left" />
                                    <TextBlock Text="The server Sync Service performs the organization-wide synchronization."
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Sage 50 customer synchronization" Style="{StaticResource SectionHeadingStyle}" />
                                    <TextBlock Text="{Binding AdminSageSyncSummary}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,6" />
                                    <TextBlock Text="{Binding AdminSageSyncDetails}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,0,0,14" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Sync Sage customers now"
                                                Command="{Binding RequestAdminSageSyncCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Margin="0,0,10,0" />
                                        <Button Content="Approve removal and sync"
                                                Command="{Binding ConfirmAdminSageRemovalCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Visibility="{Binding AdminSageRequiresConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock Text="The server Sync Service performs this manual customer synchronization."
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Active TechBench clients" Style="{StaticResource SectionHeadingStyle}" />
                                        <TextBlock Text="Clients are considered active while their 15-second heartbeat was seen within the last 90 seconds."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Refresh all"
                                            Command="{Binding RefreshAdminCenterCommand}"
                                            ToolTip="Refresh WHD and Sage synchronization status, active clients, and recent responses."
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            VerticalAlignment="Top" />
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding AdminCenterActionStatus}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />

                                <Grid Grid.Row="2" MinHeight="360">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <ListBox Grid.Column="0"
                                             ItemsSource="{Binding ActiveClientSessions}"
                                             SelectedItem="{Binding SelectedActiveClientSession}"
                                             ItemContainerStyle="{StaticResource ListBoxItemCardStyle}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SelectableEntryCardStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding UserLabel}"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="15" />
                                                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                                       Margin="0,4,0,0">
                                                                <Run Text="{Binding LoginName}" />
                                                                <Run Text=" on " />
                                                                <Run Text="{Binding MachineName}" />
                                                            </TextBlock>
                                                            <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                                       Margin="0,3,0,0">
                                                                <Run Text="Version " />
                                                                <Run Text="{Binding ClientVersion}" />
                                                                <Run Text=" | " />
                                                                <Run Text="{Binding CurrentSection}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding ActivityLabel, Mode=OneWay}"
                                                                       Foreground="{DynamicResource WarningBrush}"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding LastSeenLabel}"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       HorizontalAlignment="Right"
                                                                       Margin="0,5,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Grid.Column="2"
                                            Background="{DynamicResource PanelAltBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Selected client" Style="{StaticResource SectionHeadingStyle}" />
                                            <TextBlock Text="{Binding SelectedActiveClientSession.UserLabel}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,4" />
                                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,14">
                                                <Run Text="{Binding SelectedActiveClientSession.MachineName}" />
                                                <Run Text=" | " />
                                                <Run Text="{Binding SelectedActiveClientSession.CurrentSection}" />
                                                <Run Text=" | " />
                                                <Run Text="{Binding SelectedActiveClientSession.ActivityLabel, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="Message" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding AdminSessionMessage, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="92"
                                                     MaxLength="500"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Margin="0,0,0,12" />
                                            <Button Content="Notify for update"
                                                    Command="{Binding NotifyClientForUpdateCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0,0,0,10" />
                                            <Button Content="Require TechBench sign-out"
                                                    Command="{Binding RequireClientSignOutCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                            <TextBlock Text="Sign-out closes only TechBench. It waits for the current posting operation and preserves unsaved entry work as a recovery draft."
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,14,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Recent client responses"
                                           Style="{StaticResource SectionHeadingStyle}" />
                                <TextBlock Text="Acknowledgments, written replies, completed sign-outs, and recovery-save failures from the last seven days."
                                           Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding RecentClientResponses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="14"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   FontWeight="SemiBold">
                                                            <Run Text="{Binding UserLabel}" />
                                                            <Run Text=" on " />
                                                            <Run Text="{Binding MachineName}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ResponseLabel}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,5,18,0" />
                                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,5,18,0">
                                                            <Run Text="Admin message: " />
                                                            <Run Text="{Binding OriginalMessage}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding AcknowledgementResult}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding AcknowledgedAtLabel}"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Settings}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="App Preferences" Style="{StaticResource SectionHeadingStyle}" />
                                        <TextBlock Text="{Binding Updates.CurrentVersionLabel}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding Updates.StatusText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10" />
                                        <ProgressBar Height="8"
                                                     Width="260"
                                                     HorizontalAlignment="Left"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding Updates.DownloadProgress, Mode=OneWay}"
                                                     Margin="0,0,0,12"
                                                     Visibility="{Binding Updates.IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <CheckBox Content="Light theme" IsChecked="{Binding IsLightTheme}" Margin="0,0,0,12" />
                                        <TextBlock Text="Shared data refresh" Style="{StaticResource FieldLabelStyle}" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                            <TextBlock Text="Every"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <TextBox Text="{Binding RefreshIntervalMinutesText, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="58"
                                                     MaxLength="3"
                                                     Margin="0,0,8,0" />
                                            <TextBlock Text="minutes (1-120)"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SharedDataRefreshStatusLabel}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12" />
                                        <WrapPanel>
                                            <Button Content="Save Settings"
                                                    Command="{Binding SaveSettingsCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Check for Updates"
                                                    Command="{Binding Updates.CheckForUpdatesCommand}"
                                                    MinWidth="140"
                                                    Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Personal Data Import" Style="{StaticResource SectionHeadingStyle}" />
                                        <TextBlock Text="Move your V1 work history, personal notes, posting history, and note links into your SQL account. Shared organization data is not imported."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12" />
                                        <WrapPanel>
                                            <Button Content="Import V1 Database..."
                                                    Command="{Binding ImportV1DatabaseCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    MinWidth="164"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Import Google Sheets CSV"
                                                    Command="{Binding ImportGoogleSheetsCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    MinWidth="164"
                                                    Margin="0,0,0,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="My Web Help Desk Posting" Style="{StaticResource SectionHeadingStyle}" />
                                        <TextBlock Text="Used only to post your work notes as you. Organization ticket synchronization is configured in TechBench Server Manager."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12" />
                                        <TextBlock Text="My WHD username" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding WhdUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                                        <TextBlock Text="My API key, password, or token" Style="{StaticResource FieldLabelStyle}" />
                                        <PasswordBox x:Name="WhdApiTokenPasswordBox"
                                                     PasswordChanged="WhdApiTokenPasswordBox_PasswordChanged"
                                                     Margin="0,0,0,8" />
                                        <Button Content="Test My WHD Posting Access"
                                                Command="{Binding TestWhdConnectionCommand}"
                                                HorizontalAlignment="Left"
                                                MinWidth="190"
                                                Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="My Sage 50 Posting" Style="{StaticResource SectionHeadingStyle}" />
                                        <TextBlock Text="TechBench uses Sage Desktop on this workstation to create and save your time tickets. The server owns every Sage ODBC setting and customer synchronization."
                                                   Style="{StaticResource MutedTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12" />
                                        <TextBlock Text="My employee ID" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding SageEmployeeId, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,10" />
                                        <TextBlock Text="My activity item ID" Style="{StaticResource FieldLabelStyle}" />
                                        <TextBox Text="{Binding SageActivityItemId, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,12" />
                                        <Button Content="Check Sage Desktop"
                                                Command="{Binding TestSageConnectionCommand}"
                                                HorizontalAlignment="Left"
                                                MinWidth="140" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,14,0,0"
                                Visibility="{Binding CanManageOrganizationSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Note Templates" Style="{StaticResource SectionHeadingStyle}" />
                                    <TextBlock Text="Organization templates are shared and Admin-managed. Legacy personal templates remain available read-only."
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />
                                     <ListBox ItemsSource="{Binding NoteTemplates}"
                                              SelectedItem="{Binding ManagedNoteTemplate}"
                                              DisplayMemberPath="DisplayName"
                                              Background="{DynamicResource ComboBoxBackgroundBrush}"
                                              Foreground="{DynamicResource ComboBoxTextBrush}"
                                              BorderBrush="{DynamicResource ComboBoxBorderBrush}"
                                              ItemContainerStyle="{StaticResource TicketSelectorItemStyle}"
                                              MinHeight="190"
                                              MaxHeight="280" />
                                    <Button Content="New Template"
                                            Command="{Binding NewNoteTemplateCommand}"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0" />
                                </StackPanel>
                                <Grid Grid.Column="2" IsEnabled="{Binding CanEditManagedNoteTemplate}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Category" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBox Text="{Binding TemplateCategory, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Text="Template text"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Margin="1,12,0,7" />
                                    <TextBox Grid.Row="2"
                                             Text="{Binding TemplateText, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             SpellCheck.IsEnabled="True"
                                             MinHeight="120"
                                             ToolTip="Placeholders: {client}, {ticket}, {date}, {duration}, {time}" />
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="Delete"
                                                Command="{Binding DeleteNoteTemplateCommand}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Margin="0,0,8,0" />
                                        <Button Content="Save Template"
                                                Command="{Binding SaveNoteTemplateCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
