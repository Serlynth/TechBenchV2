<UserControl x:Class="TechBench.Controls.ClientEquipmentDetailsDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TechBench.Converters"
             Width="520"
             HorizontalAlignment="Right"
             VerticalAlignment="Stretch"
             Focusable="False">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <Style x:Key="EquipmentProfileLabelStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="EquipmentProfileValueStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="EquipmentProfileFieldStyle"
               TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1,0,0,0"
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Equipment Details"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="21"
                               FontWeight="SemiBold" />
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,3,0,0">
                        <Run Text="Assigned to " />
                        <Run Text="{Binding SelectedEquipment.AssignmentLabel, Mode=OneWay}"
                             FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Close"
                        Command="{Binding CloseEquipmentDetailsCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        VerticalAlignment="Top" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,8">
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="11"
                            Margin="0,0,0,12">
                        <TextBlock Text="Read-only client profile view. The client overview remains open behind this drawer."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="13"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38"
                                    Height="38"
                                    CornerRadius="9"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{Binding SelectedEquipment.DeviceBadgeColor}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding SelectedEquipment.DeviceGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{Binding SelectedEquipment.DeviceBadgeColor}"
                                           FontSize="19"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SelectedEquipment.Name}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedEquipment.ModelLine}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    CornerRadius="10"
                                    Padding="8,4"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding SelectedEquipment.StatusLabel}"
                                           Foreground="{Binding SelectedEquipment.StatusColor}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="EQUIPMENT"
                               Foreground="{DynamicResource AccentHoverBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="1,0,0,8" />
                    <UniformGrid Columns="2"
                                 Margin="0,0,-10,2">
                        <Border Style="{StaticResource EquipmentProfileFieldStyle}">
                            <StackPanel>
                                <TextBlock Text="Device type"
                                           Style="{StaticResource EquipmentProfileLabelStyle}" />
                                <TextBlock Text="{Binding SelectedEquipment.DeviceType}"
                                           Style="{StaticResource EquipmentProfileValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EquipmentProfileFieldStyle}"
                                Visibility="{Binding SelectedEquipment.AssetTag, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Asset tag"
                                           Style="{StaticResource EquipmentProfileLabelStyle}" />
                                <TextBlock Text="{Binding SelectedEquipment.AssetTag}"
                                           Style="{StaticResource EquipmentProfileValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EquipmentProfileFieldStyle}"
                                Visibility="{Binding SelectedEquipment.SerialNumber, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Serial number"
                                           Style="{StaticResource EquipmentProfileLabelStyle}" />
                                <TextBlock Text="{Binding SelectedEquipment.SerialNumber}"
                                           Style="{StaticResource EquipmentProfileValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EquipmentProfileFieldStyle}"
                                Visibility="{Binding SelectedEquipment.PartNumber, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Part number"
                                           Style="{StaticResource EquipmentProfileLabelStyle}" />
                                <TextBlock Text="{Binding SelectedEquipment.PartNumber}"
                                           Style="{StaticResource EquipmentProfileValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EquipmentProfileFieldStyle}"
                                Visibility="{Binding SelectedEquipment.Manufacturer, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Manufacturer"
                                           Style="{StaticResource EquipmentProfileLabelStyle}" />
                                <TextBlock Text="{Binding SelectedEquipment.Manufacturer}"
                                           Style="{StaticResource EquipmentProfileValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EquipmentProfileFieldStyle}"
                                Visibility="{Binding SelectedEquipment.IpAddress, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="IP address"
                                           Style="{StaticResource EquipmentProfileLabelStyle}" />
                                <TextBlock Text="{Binding SelectedEquipment.IpAddress}"
                                           Style="{StaticResource EquipmentProfileValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource EquipmentProfileFieldStyle}"
                                Visibility="{Binding SelectedEquipment.AnyDeskNumber, Converter={StaticResource StringToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="AnyDesk number"
                                           Style="{StaticResource EquipmentProfileLabelStyle}" />
                                <TextBlock Text="{Binding SelectedEquipment.AnyDeskNumber}"
                                           Style="{StaticResource EquipmentProfileValueStyle}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="ASSIGNMENT"
                               Foreground="{DynamicResource AccentHoverBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="1,2,0,8" />
                    <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Visibility="{Binding SelectedEquipment.ClientName, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="Client"
                                           Style="{StaticResource EquipmentProfileLabelStyle}" />
                                <TextBlock Text="{Binding SelectedEquipment.ClientName}"
                                           Style="{StaticResource EquipmentProfileValueStyle}"
                                           Margin="0,0,0,10" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding SelectedEquipment.ClientUserDisplayName, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="Client user / shared role"
                                           Style="{StaticResource EquipmentProfileLabelStyle}" />
                                <TextBlock Text="{Binding SelectedEquipment.ClientUserDisplayName}"
                                           Style="{StaticResource EquipmentProfileValueStyle}"
                                           Margin="0,0,0,10" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding SelectedEquipment.LocationName, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="Site / room / desk"
                                           Style="{StaticResource EquipmentProfileLabelStyle}" />
                                <TextBlock Text="{Binding SelectedEquipment.LocationName}"
                                           Style="{StaticResource EquipmentProfileValueStyle}"
                                           Margin="0,0,0,10" />
                            </StackPanel>
                            <TextBlock Text="Technician"
                                       Style="{StaticResource EquipmentProfileLabelStyle}" />
                            <TextBlock Text="{Binding SelectedEquipment.TechnicianLabel}"
                                       Style="{StaticResource EquipmentProfileValueStyle}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding SelectedEquipment.Notes, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="NOTES"
                                   Foreground="{DynamicResource AccentHoverBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="1,0,0,8" />
                        <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12">
                            <TextBlock Text="{Binding SelectedEquipment.Notes}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2"
                    Content="Back to client overview"
                    Command="{Binding CloseEquipmentDetailsCommand}"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Margin="0,12,0,0" />
        </Grid>
    </Border>
</UserControl>
