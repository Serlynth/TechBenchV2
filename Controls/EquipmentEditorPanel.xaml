<UserControl x:Class="TechBench.Controls.EquipmentEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TechBench.Converters"
             Width="430"
             HorizontalAlignment="Right"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <Style x:Key="EquipmentEditorFieldLabelStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="1,0,0,7" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding EquipmentEditorTitle}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,4,0,0">
                        <Run Text="Assigned to " />
                        <Run Text="{Binding EquipmentAssignmentLabel, Mode=OneWay}"
                             FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Copy details"
                        Command="{Binding CopyEquipmentDetailsCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Margin="8,0,8,0"
                        ToolTip="Copy the equipment record without copying the AnyDesk password." />
                <Button Grid.Column="2"
                        Content="Close"
                        Command="{Binding CancelEquipmentEditCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,8">
                    <Border Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="11"
                            Margin="0,0,0,12">
                        <TextBlock Text="Inventory is the record of truth. Technician assignment and deployment order remain on Equipment Board."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="10" />
                    </Border>

                    <TextBlock Text="Device type"
                               Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding EquipmentTypeOptions}"
                              Text="{Binding EquipmentDeviceType, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Asset tag"
                               Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                    <TextBox Text="{Binding EquipmentAssetTag, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="80"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Equipment name"
                               Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                    <TextBox Text="{Binding EquipmentName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="180"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Serial number"
                               Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                    <TextBox Text="{Binding EquipmentSerialNumber, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="120"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Part number"
                               Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                    <TextBox Text="{Binding EquipmentPartNumber, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="120"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Manufacturer"
                               Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                    <TextBox Text="{Binding EquipmentManufacturer, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="120"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Model"
                               Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                    <TextBox Text="{Binding EquipmentModel, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="120"
                             Margin="0,0,0,12" />

                    <TextBlock Text="IP address"
                               Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                    <TextBox Text="{Binding EquipmentIpAddress, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="80"
                             Margin="0,0,0,12" />

                    <StackPanel Visibility="{Binding EquipmentSupportsAnyDesk, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,4,0,12">
                            <StackPanel>
                                <TextBlock Text="AnyDesk remote access"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Available for desktop and laptop records. The password remains encrypted in SQL Server."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="10"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="AnyDesk number"
                                   Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                        <TextBox Text="{Binding EquipmentAnyDeskNumber, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="80"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="AnyDesk password"
                                   Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                        <TextBox Text="••••••••"
                                 IsReadOnly="True"
                                 Visibility="{Binding ShowEquipmentAnyDeskPassword, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                 Margin="0,0,0,8" />
                        <TextBox Text="{Binding EquipmentAnyDeskPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ShowEquipmentAnyDeskPassword, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="0,0,0,8" />
                        <CheckBox Content="Show and edit AnyDesk password"
                                  IsChecked="{Binding ShowEquipmentAnyDeskPassword}"
                                  Margin="0,0,0,10" />
                        <Button Content="Connect with AnyDesk"
                                Command="{Binding LaunchAnyDeskCommand}"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,12"
                                ToolTip="Open AnyDesk, connect to this address, and submit the stored unattended-access password when available." />
                    </StackPanel>

                    <Border Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,4,0,12">
                        <StackPanel>
                            <TextBlock Text="Client assignment"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Choose the client and person or shared role that will receive this device."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="10"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Client"
                               Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding InventoryClientOptions}"
                              SelectedItem="{Binding EquipmentClient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Name"
                              IsTextSearchEnabled="True"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Client user / shared role"
                               Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding InventoryClientUserOptions}"
                              SelectedItem="{Binding EquipmentClientUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DisplayLabel"
                              IsTextSearchEnabled="True"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Site / room / desk"
                               Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                    <TextBox Text="{Binding EquipmentLocationName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="240"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Notes"
                               Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                    <TextBox Text="{Binding EquipmentNotes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="90"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,12" />

                    <TextBlock Text="Assignment history"
                               Style="{StaticResource EquipmentEditorFieldLabelStyle}" />
                    <ItemsControl ItemsSource="{Binding EquipmentAssignmentHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="9"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontWeight="SemiBold">
                                            <Run Text="{Binding EventType}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding WorkflowStage}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding ClientChipLabel}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding AssignedAtUtc, StringFormat={}{0:g}}"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="9" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="Save Equipment"
                        Command="{Binding SaveEquipmentCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Margin="0,0,10,0" />
                <Button Grid.Column="1"
                        Content="Archive"
                        Command="{Binding ArchiveEquipmentCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Foreground="{DynamicResource DangerBrush}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
