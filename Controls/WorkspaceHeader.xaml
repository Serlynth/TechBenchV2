<UserControl x:Class="TechBench.Controls.WorkspaceHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="WorkspaceHeaderUpdateButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="UpdateBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="UpdateBorder"
                                        Property="Background"
                                        Value="{DynamicResource SuccessSoftHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="UpdateBorder"
                                        Property="Opacity"
                                        Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="UpdateBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="24,0"
            Background="{DynamicResource HeaderBackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"
                        Margin="0,0,20,0">
                <TextBlock Text="WORKSPACE"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="9"
                           FontWeight="Bold"
                           Margin="0,0,0,2" />
                <TextBlock Text="{Binding CurrentSection}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="10"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Command="{Binding Updates.ShowUpdateBannerCommand}"
                        Style="{StaticResource WorkspaceHeaderUpdateButtonStyle}"
                        ToolTip="{Binding Updates.BannerTitle}"
                        AutomationProperties.Name="{Binding Updates.BannerTitle}"
                        Margin="0,0,10,0"
                        Visibility="{Binding Updates.HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2193;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   Margin="0,-2,7,0" />
                        <TextBlock Text="{Binding Updates.HeaderUpdateLabel}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="13,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Fill"
                                            Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editor.IsDirty}"
                                                     Value="True">
                                            <Setter Property="Fill"
                                                    Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEntryOperationRunning}"
                                                     Value="True">
                                            <Setter Property="Fill"
                                                    Value="{DynamicResource AccentHoverBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding WorkspaceStateLabel}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
