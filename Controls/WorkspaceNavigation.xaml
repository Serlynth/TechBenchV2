<UserControl x:Class="TechBench.Controls.WorkspaceNavigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TechBench.Converters"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:SectionActiveConverter x:Key="SectionActiveConverter" />

        <Style x:Key="WorkspaceGroupHeaderToggleStyle"
               TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarMutedTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="HeaderBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <Path x:Name="Chevron"
                                      Grid.Column="1"
                                      Width="8"
                                      Height="5"
                                      Margin="8,0,2,0"
                                      Data="M 0 0 L 4 4 L 8 0"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBackground"
                                        Property="Background"
                                        Value="{DynamicResource SidebarHoverBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceGroupStyle"
               TargetType="{x:Type Expander}">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderSite"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource WorkspaceGroupHeaderToggleStyle}" />
                            <ContentPresenter x:Name="ExpandSite"
                                              Grid.Row="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="0,1,0,2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpandSite"
                                        Property="Visibility"
                                        Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceNavItemStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,1" />
        </Style>

        <Style x:Key="BenchModuleSwitchButtonStyle"
               TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource SidebarMutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,6" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ModuleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModuleBorder"
                                        Property="Background"
                                        Value="{DynamicResource SidebarHoverBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="ModuleBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ModuleBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="14,16,14,14">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top"
                        Margin="2,0,2,10">
                <Grid Height="68">
                    <Image Source="/TechBenchV2;component/Assets/csri-techbench-logo.png"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>

                <UniformGrid Columns="3"
                             Margin="0,5,0,0"
                             Visibility="{Binding CanAccessBenchModules, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="TECH"
                            Command="{Binding SwitchBenchModuleCommand}"
                            CommandParameter="TechBench"
                            Tag="{Binding ActiveBenchModule, Converter={StaticResource SectionActiveConverter}, ConverterParameter=TechBench}"
                            Style="{StaticResource BenchModuleSwitchButtonStyle}"
                            Margin="0,0,3,0" />
                    <Button Content="SALES"
                            Command="{Binding SwitchBenchModuleCommand}"
                            CommandParameter="SalesBench"
                            Tag="{Binding ActiveBenchModule, Converter={StaticResource SectionActiveConverter}, ConverterParameter=SalesBench}"
                            Style="{StaticResource BenchModuleSwitchButtonStyle}"
                            Margin="2,0" />
                    <Button Content="ADMIN"
                            Command="{Binding SwitchBenchModuleCommand}"
                            CommandParameter="AdminBench"
                            Tag="{Binding ActiveBenchModule, Converter={StaticResource SectionActiveConverter}, ConverterParameter=AdminBench}"
                            Style="{StaticResource BenchModuleSwitchButtonStyle}"
                            Margin="3,0,0,0" />
                </UniformGrid>
            </StackPanel>

            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="11,9"
                    Margin="2,10,2,0"
                    ToolTip="{Binding DatabasePath}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{DynamicResource SuccessBrush}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SHARED WORKSPACE"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding DatabasePath}"
                                   Foreground="{DynamicResource SidebarMutedTextBrush}"
                                   FontSize="9"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="SidebarNavigationScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <StackPanel>
                    <StackPanel Visibility="{Binding IsTechBenchModule, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Expander Header="NOTES"
                              Style="{StaticResource WorkspaceGroupStyle}">
                        <StackPanel>
                            <Button Content="Today"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Today"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Today}"
                                    Style="{StaticResource WorkspaceNavItemStyle}" />
                            <Button Content="This Week"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="This Week"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=This Week}"
                                    Style="{StaticResource WorkspaceNavItemStyle}" />
                            <Button Content="History"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="History"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=History}"
                                    Style="{StaticResource WorkspaceNavItemStyle}" />
                            <Button Content="Search"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Search"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Search}"
                                    Style="{StaticResource WorkspaceNavItemStyle}" />
                            <Button Content="Tickets"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Ticket List"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Ticket List}"
                                    Style="{StaticResource WorkspaceNavItemStyle}" />
                            <Button Content="Posting Queue"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Posting Queue"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Posting Queue}"
                                    Style="{StaticResource WorkspaceNavItemStyle}" />
                            <Button Content="Posting History"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Posting History"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Posting History}"
                                    Style="{StaticResource WorkspaceNavItemStyle}" />
                        </StackPanel>
                        </Expander>

                        <Expander Header="CLIENTS"
                              Style="{StaticResource WorkspaceGroupStyle}">
                        <StackPanel>
                            <Button Content="Overview"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Client Info"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Client Info}"
                                    Style="{StaticResource WorkspaceNavItemStyle}"
                                    Visibility="{Binding CanAccessFireDrill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Users"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Client Users"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Client Users}"
                                    Style="{StaticResource WorkspaceNavItemStyle}"
                                    Visibility="{Binding CanAccessClientUsers, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="WiFi"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Client WiFi"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Client WiFi}"
                                    Style="{StaticResource WorkspaceNavItemStyle}"
                                    Visibility="{Binding CanAccessFireDrill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Domain &amp; AD"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Domain/AD"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Domain/AD}"
                                    Style="{StaticResource WorkspaceNavItemStyle}"
                                    Visibility="{Binding CanAccessFireDrill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Connections"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Connection"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Connection}"
                                    Style="{StaticResource WorkspaceNavItemStyle}"
                                    Visibility="{Binding CanAccessFireDrill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Miscellaneous"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Misc Info"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Misc Info}"
                                    Style="{StaticResource WorkspaceNavItemStyle}"
                                    Visibility="{Binding CanAccessFireDrill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Common Links"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Common Links"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Common Links}"
                                    Style="{StaticResource WorkspaceNavItemStyle}" />
                        </StackPanel>
                        </Expander>

                        <Expander Header="EQUIPMENT"
                              Style="{StaticResource WorkspaceGroupStyle}"
                              Visibility="{Binding CanAccessEquipmentBoard, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Button Content="Inventory"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Inventory"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Inventory}"
                                    Style="{StaticResource WorkspaceNavItemStyle}" />
                            <Button Content="Equipment Board"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Equipment Board"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Equipment Board}"
                                    Style="{StaticResource WorkspaceNavItemStyle}" />
                        </StackPanel>
                        </Expander>

                        <Expander Header="SYSTEM"
                              Style="{StaticResource WorkspaceGroupStyle}">
                        <StackPanel>
                            <Button Content="Client Matching"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Client Match"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Client Match}"
                                    Style="{StaticResource WorkspaceNavItemStyle}" />
                            <Button Content="Admin Center"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Admin Center"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Admin Center}"
                                    Style="{StaticResource WorkspaceNavItemStyle}"
                                    Visibility="{Binding CanAccessAdminCenter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="Settings"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Settings"
                                    Tag="{Binding CurrentSection, Converter={StaticResource SectionActiveConverter}, ConverterParameter=Settings}"
                                    Style="{StaticResource WorkspaceNavItemStyle}" />
                        </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- These are intentionally separate, empty navigation
                         surfaces so each private beta module can grow without
                         coupling its future destinations to TechBench. -->
                    <Grid x:Name="SalesBenchNavigation"
                          MinHeight="1"
                          Visibility="{Binding IsSalesBenchModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid x:Name="AdminBenchNavigation"
                          MinHeight="1"
                          Visibility="{Binding IsAdminBenchModule, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
