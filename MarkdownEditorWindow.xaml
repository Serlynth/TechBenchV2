<Window x:Class="TechBench.MarkdownEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TechBench.Controls"
        Title="Internal Note - Markdown"
        Icon="Assets/csri-techbench-icon.ico"
        Width="1200"
        Height="780"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ModeButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="ModeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelAltBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Internal Note"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                        <Border x:Name="ReadOnlyBadge"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,3"
                                Margin="10,0,0,0"
                                Visibility="Collapsed">
                            <TextBlock Text="READ ONLY"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Markdown"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="SourceModeButton"
                                 Content="Source"
                                 GroupName="EditorMode"
                                 Style="{StaticResource ModeButtonStyle}"
                                 Margin="0,0,6,0"
                                 Checked="ModeButton_Checked" />
                    <RadioButton x:Name="SplitModeButton"
                                 Content="Split"
                                 GroupName="EditorMode"
                                 Style="{StaticResource ModeButtonStyle}"
                                 Margin="0,0,6,0"
                                 IsChecked="True"
                                 Checked="ModeButton_Checked" />
                    <RadioButton x:Name="PreviewModeButton"
                                 Content="Preview"
                                 GroupName="EditorMode"
                                 Style="{StaticResource ModeButtonStyle}"
                                 Checked="ModeButton_Checked" />
                </StackPanel>

                <Button x:Name="FullScreenButton"
                        Grid.Column="3"
                        Content="Full screen"
                        MinWidth="104"
                        VerticalAlignment="Center"
                        ToolTip="Toggle full screen (F11)"
                        Click="FullScreenButton_Click" />
            </Grid>
        </Border>

        <Grid x:Name="EditorLayoutGrid" Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SourceColumn" Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="8" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SourcePane"
                    Grid.Column="0"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="6,6,0,0">
                        <TextBlock Text="SOURCE"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="14,0" />
                    </Border>
                    <TextBox x:Name="SourceTextBox"
                             Grid.Row="1"
                             Style="{x:Null}"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="13"
                             TextBlock.LineHeight="20"
                             Background="Transparent"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             CaretBrush="{DynamicResource PrimaryTextBrush}"
                             BorderThickness="0"
                             Padding="14,12"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             SpellCheck.IsEnabled="True"
                             UndoLimit="500"
                             IsReadOnlyCaretVisible="True"
                             TextChanged="SourceTextBox_TextChanged"
                             SelectionChanged="SourceTextBox_SelectionChanged" />
                </Grid>
            </Border>

            <GridSplitter x:Name="PaneSplitter"
                          Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" />

            <Border x:Name="PreviewPane"
                    Grid.Column="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="6,6,0,0">
                        <TextBlock Text="PREVIEW"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="14,0" />
                    </Border>
                    <controls:MarkdownViewer x:Name="PreviewViewer"
                                             Grid.Row="1"
                                             Padding="14,12"
                                             BaseFontSize="13" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelAltBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="DocumentStatsText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            MinWidth="92"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click" />
                    <Button x:Name="ApplyButton"
                            Content="Apply to Entry"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="124"
                            Click="ApplyButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
